diff --git a/drivers/media/i2c/luma-camprobe.c b/drivers/media/i2c/luma-camprobe.c
new file mode 100644
index 0000000..be37bea
--- /dev/null
+++ b/drivers/media/i2c/luma-camprobe.c
@@ -0,0 +1,371 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Camera bring-up probe for boards whose sensors have no driver yet.
+ *
+ * Powers the camera supplies, then brings the sensors up one at a time with
+ * the power sequence of the vendor camera stack (reset low, rails, MCLK,
+ * reset high, standby/select lines) and reads each sensor's chip id at its
+ * known address. It never writes sensor registers. Load it, read dmesg,
+ * unload it.
+ *
+ * The sensor table below is for the Xiaomi POCO X3 NFC (surya); the order
+ * of reset-gpios, enable-gpios, clocks and luma,i2c-buses in the device
+ * tree node must match it.
+ */
+#include <linux/clk.h>
+#include <linux/clk-provider.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+
+static bool hold;
+module_param(hold, bool, 0444);
+MODULE_PARM_DESC(hold, "Keep the cameras powered after the tests (until unload)");
+
+static uint mclk_hz = 19200000;
+module_param(mclk_hz, uint, 0444);
+MODULE_PARM_DESC(mclk_hz, "MCLK rate to try first (the vendor stack uses 19.2 MHz)");
+
+static char *only;
+module_param(only, charp, 0444);
+MODULE_PARM_DESC(only, "Test only this sensor (main, depth, front, ultrawide, macro)");
+
+static const char * const camprobe_supplies[] = { "vio", "vdig-main", "vdig", "mipi-switch", "uw-ois",
+						  "l7c", "l8c" };
+
+/* indexes into the device tree lists */
+enum { BUS_CCI0_M0, BUS_CCI0_M1, BUS_CCI1_M0, NUM_BUSES };
+enum { EN_MAIN_STANDBY, EN_CAM_SEL, EN_MACRO_CHIP_EN, EN_TELE_AF };
+#define NONE	-1
+
+struct camprobe_id {
+	u8 addr;		/* 7-bit */
+	u16 reg;
+	bool reg16;
+	u8 len;			/* 1 or 2 bytes */
+	u16 expect;
+	const char *name;
+};
+
+struct camprobe_sensor {
+	const char *role;
+	int bus, mclk, reset;
+	int en;			/* enable/standby line, or NONE */
+	int en_level;		/* level the vendor sequence puts it at */
+	int en_after_reset;	/* raise it after reset (main) instead of before */
+	struct camprobe_id ids[3];
+};
+
+/* From the vendor sensor modules (com.qti.sensormodule.j20c_*.bin) and DT. */
+static const struct camprobe_sensor sensors[] = {
+	{ "main", BUS_CCI0_M0, 1, 0, EN_MAIN_STANDBY, 1, 1, {
+		{ 0x1a, 0x0016, true, 2, 0x0682, "Sony IMX682 (0x0684 = ver2)" } } },
+	{ "depth", BUS_CCI0_M1, 0, 1, NONE, 0, 0, {
+		{ 0x37, 0xf0, false, 2, 0x02e0, "GalaxyCore GC02M1B" },
+		{ 0x3c, 0x02, false, 2, 0x002b, "OmniVision OV02B1B" },
+		{ 0x3c, 0x0203, true, 1, 0x002b, "OmniVision OV02B1B (16-bit reg)" } } },
+	{ "front", BUS_CCI0_M1, 0, 2, EN_CAM_SEL, 0, 0, {
+		{ 0x10, 0x0000, true, 2, 0x3142, "Samsung S5K3T2" },
+		{ 0x2d, 0x0000, true, 2, 0x3142, "Samsung S5K3T2 (alt address)" } } },
+	{ "ultrawide", BUS_CCI1_M0, 3, 3, EN_CAM_SEL, 1, 0, {
+		{ 0x21, 0x0716, true, 2, 0x1337, "Hynix HI1337" } } },
+	{ "macro", BUS_CCI1_M0, 2, 4, EN_MACRO_CHIP_EN, 1, 0, {
+		{ 0x38, 0x04, false, 1, 0x00e1, "Hynix HI259" } } },
+};
+
+struct camprobe {
+	struct device *dev;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(camprobe_supplies)];
+	struct clk_bulk_data *clks;
+	int num_clks;
+	struct gpio_descs *resets;
+	struct gpio_descs *enables;
+	struct i2c_adapter *buses[NUM_BUSES];
+};
+
+static int camprobe_read(struct i2c_adapter *adap, u16 addr, u16 reg, bool reg16,
+			 u8 *val, int len)
+{
+	u8 r[2] = { reg >> 8, reg & 0xff };
+	struct i2c_msg msgs[2] = {
+		{ .addr = addr, .flags = 0, .len = reg16 ? 2 : 1, .buf = reg16 ? r : &r[1] },
+		{ .addr = addr, .flags = I2C_M_RD, .len = len, .buf = val },
+	};
+	int ret = i2c_transfer(adap, msgs, 2);
+
+	return ret == 2 ? 0 : (ret < 0 ? ret : -EIO);
+}
+
+static void camprobe_gpio(struct gpio_descs *d, int i, int val)
+{
+	if (d && i >= 0 && i < d->ndescs)
+		gpiod_set_value_cansleep(d->desc[i], val);
+}
+
+static void camprobe_all_reset(struct camprobe *cp)
+{
+	int i;
+
+	/* reset-gpios are ACTIVE_LOW: logical 1 = line low = in reset */
+	for (i = 0; cp->resets && i < cp->resets->ndescs; i++)
+		gpiod_set_value_cansleep(cp->resets->desc[i], 1);
+	for (i = 0; cp->enables && i < cp->enables->ndescs; i++)
+		gpiod_set_value_cansleep(cp->enables->desc[i], 0);
+}
+
+/* List the addresses that answer on one bus, compactly. */
+static void camprobe_acks(struct camprobe *cp, int bus, const char *tag)
+{
+	struct i2c_adapter *adap = cp->buses[bus];
+	char line[256];
+	int addr, n = 0;
+	u8 v;
+
+	if (!adap)
+		return;
+	line[0] = 0;
+	for (addr = 0x08; addr < 0x78; addr++) {
+		if (!camprobe_read(adap, addr, 0x0000, true, &v, 1) ||
+		    !camprobe_read(adap, addr, 0x00, false, &v, 1))
+			n += scnprintf(line + n, sizeof(line) - n, " 0x%02x", addr);
+	}
+	dev_info(cp->dev, "  %s: bus %d answers:%s\n", tag, bus, n ? line : " none");
+}
+
+static void camprobe_state(struct camprobe *cp, const struct camprobe_sensor *s)
+{
+	struct clk *mclk = cp->clks[s->mclk].clk;
+	int i, n = 0;
+	char line[200];
+
+	for (i = 0; i < ARRAY_SIZE(cp->supplies); i++) {
+		struct regulator *r = cp->supplies[i].consumer;
+
+		n += scnprintf(line + n, sizeof(line) - n, " %s=%s/%d", cp->supplies[i].supply,
+			       regulator_is_enabled(r) > 0 ? "on" : "OFF",
+			       regulator_get_voltage(r) / 1000);
+	}
+	dev_info(cp->dev, "  rails:%s\n", line);
+	dev_info(cp->dev, "  mclk%d %s at %lu Hz, reset line %s, enable line %s\n", s->mclk,
+		 __clk_is_enabled(mclk) ? "on" : "OFF", clk_get_rate(mclk),
+		 gpiod_get_raw_value_cansleep(cp->resets->desc[s->reset]) ? "high" : "low",
+		 s->en == NONE ? "-" :
+		 gpiod_get_raw_value_cansleep(cp->enables->desc[s->en]) ? "high" : "low");
+}
+
+static bool camprobe_try(struct camprobe *cp, const struct camprobe_sensor *s,
+			 unsigned long rate, int en_level)
+{
+	struct clk *mclk = cp->clks[s->mclk].clk;
+	struct i2c_adapter *adap = cp->buses[s->bus];
+	bool found = false;
+	int i, ret;
+
+	camprobe_all_reset(cp);
+	msleep(5);
+	if (s->en != NONE && !s->en_after_reset)
+		camprobe_gpio(cp->enables, s->en, en_level);
+	clk_set_rate(mclk, rate);
+	ret = clk_prepare_enable(mclk);
+	if (ret) {
+		dev_err(cp->dev, "  mclk%d enable: %d\n", s->mclk, ret);
+		return false;
+	}
+	usleep_range(10000, 11000);
+	camprobe_gpio(cp->resets, s->reset, 0);		/* out of reset */
+	usleep_range(10000, 11000);
+	if (s->en != NONE && s->en_after_reset)
+		camprobe_gpio(cp->enables, s->en, en_level);
+	msleep(20);
+
+	dev_info(cp->dev, "%s: mclk %lu Hz, %s\n", s->role, rate,
+		 s->en == NONE ? "no enable line" : en_level ? "enable high" : "enable low");
+	camprobe_state(cp, s);
+	for (i = 0; i < ARRAY_SIZE(s->ids) && s->ids[i].name; i++) {
+		const struct camprobe_id *id = &s->ids[i];
+		u8 v[2] = { 0, 0 };
+		u16 got;
+
+		ret = camprobe_read(adap, id->addr, id->reg, id->reg16, v, id->len);
+		if (ret) {
+			dev_info(cp->dev, "  %s at 0x%02x: no answer (%d)\n", id->name, id->addr, ret);
+			continue;
+		}
+		got = id->len == 2 ? (v[0] << 8) | v[1] : v[0];
+		dev_info(cp->dev, "  %s at 0x%02x: id 0x%04x%s\n", id->name, id->addr, got,
+			 got == id->expect || (id->expect == 0x0682 && got == 0x0684) ?
+			 " -> FOUND" : " (unexpected id)");
+		found = true;
+	}
+	if (!found)
+		camprobe_acks(cp, s->bus, s->role);
+
+	camprobe_gpio(cp->resets, s->reset, 1);
+	clk_disable_unprepare(mclk);
+	camprobe_all_reset(cp);
+	return found;
+}
+
+static void camprobe_eeproms(struct camprobe *cp)
+{
+	int bus, addr, off;
+	u8 v[8], head[32];
+
+	for (bus = 0; bus < NUM_BUSES; bus++) {
+		if (!cp->buses[bus])
+			continue;
+		for (addr = 0x50; addr <= 0x57; addr++) {
+			/* the CCI reads at most a few bytes per transfer: 8 at a time */
+			for (off = 0; off < sizeof(head); off += sizeof(v)) {
+				if (camprobe_read(cp->buses[bus], addr, off, true, v, sizeof(v)))
+					break;
+				memcpy(head + off, v, sizeof(v));
+			}
+			if (off)
+				dev_info(cp->dev, "eeprom bus %d 0x%02x: %*ph\n", bus, addr, off, head);
+		}
+	}
+}
+
+static int camprobe_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct of_phandle_iterator it;
+	struct camprobe *cp;
+	int i, ret, nbus = 0;
+
+	cp = devm_kzalloc(dev, sizeof(*cp), GFP_KERNEL);
+	if (!cp)
+		return -ENOMEM;
+	cp->dev = dev;
+
+	for (i = 0; i < ARRAY_SIZE(camprobe_supplies); i++)
+		cp->supplies[i].supply = camprobe_supplies[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(cp->supplies), cp->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "supplies\n");
+	cp->num_clks = devm_clk_bulk_get_all(dev, &cp->clks);
+	if (cp->num_clks < 4)
+		return dev_err_probe(dev, cp->num_clks < 0 ? cp->num_clks : -EINVAL,
+				     "need clocks MCLK0..3\n");
+	cp->resets = devm_gpiod_get_array(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(cp->resets))
+		return dev_err_probe(dev, PTR_ERR(cp->resets), "reset gpios\n");
+	cp->enables = devm_gpiod_get_array(dev, "enable", GPIOD_OUT_LOW);
+	if (IS_ERR(cp->enables))
+		return dev_err_probe(dev, PTR_ERR(cp->enables), "enable gpios\n");
+	if (cp->resets->ndescs < 5 || cp->enables->ndescs < 3)
+		return dev_err_probe(dev, -EINVAL, "need 5 reset and 3 enable gpios\n");
+
+	of_for_each_phandle(&it, ret, dev->of_node, "luma,i2c-buses", NULL, 0) {
+		if (nbus < NUM_BUSES)
+			cp->buses[nbus] = of_find_i2c_adapter_by_node(it.node);
+		if (nbus < NUM_BUSES && !cp->buses[nbus])
+			dev_warn(dev, "%pOF: no adapter (bus disabled?)\n", it.node);
+		nbus++;
+	}
+
+	devm_pm_runtime_enable(dev);
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret) {
+		dev_err(dev, "power domain: %d\n", ret);
+		goto put_buses;
+	}
+
+	/* Vendor DT runs the camera IO (cam_vio) at 1.8 V; L13A defaults lower. */
+	ret = regulator_set_voltage(cp->supplies[0].consumer, 1800000, 1800000);
+	if (ret)
+		dev_warn(dev, "vio to 1.8 V: %d\n", ret);
+	ret = regulator_bulk_enable(ARRAY_SIZE(cp->supplies), cp->supplies);
+	if (ret) {
+		dev_err(dev, "enable supplies: %d\n", ret);
+		goto put_pm;
+	}
+	camprobe_all_reset(cp);
+	msleep(10);
+
+	dev_info(dev, "v5: one sensor at a time with the vendor power sequence\n");
+	for (i = 0; i < ARRAY_SIZE(sensors); i++) {
+		const struct camprobe_sensor *s = &sensors[i];
+		bool ok;
+
+		if (only && strcmp(only, s->role))
+			continue;
+		if (!cp->buses[s->bus]) {
+			dev_info(dev, "%s: bus %d missing, skipped\n", s->role, s->bus);
+			continue;
+		}
+		ok = camprobe_try(cp, s, mclk_hz, s->en_level);
+		if (!ok && s->en != NONE)
+			ok = camprobe_try(cp, s, mclk_hz, !s->en_level);
+		if (!ok)
+			ok = camprobe_try(cp, s, mclk_hz == 24000000 ? 19200000 : 24000000,
+					  s->en_level);
+		dev_info(dev, "%s: %s\n", s->role, ok ? "ANSWERS" : "silent");
+	}
+
+	/* EEPROMs need only the rails; read their headers with every sensor out of reset. */
+	for (i = 0; i < cp->resets->ndescs; i++)
+		gpiod_set_value_cansleep(cp->resets->desc[i], 0);
+	camprobe_eeproms(cp);
+
+	if (hold) {
+		camprobe_gpio(cp->enables, EN_MAIN_STANDBY, 1);
+		camprobe_gpio(cp->enables, EN_CAM_SEL, 1);
+		camprobe_gpio(cp->enables, EN_MACRO_CHIP_EN, 1);
+		clk_bulk_prepare_enable(cp->num_clks, cp->clks);
+		platform_set_drvdata(pdev, cp);
+		dev_info(dev, "holding the cameras powered (out of reset) until unload\n");
+		return 0;
+	}
+	camprobe_all_reset(cp);
+	regulator_bulk_disable(ARRAY_SIZE(cp->supplies), cp->supplies);
+put_pm:
+	pm_runtime_put(dev);
+put_buses:
+	for (i = 0; i < NUM_BUSES; i++)
+		if (cp->buses[i])
+			i2c_put_adapter(cp->buses[i]);
+	dev_info(dev, "cameras powered off\n");
+	return 0;
+}
+
+static void camprobe_remove(struct platform_device *pdev)
+{
+	struct camprobe *cp = platform_get_drvdata(pdev);
+	int i;
+
+	if (!cp)
+		return;
+	camprobe_all_reset(cp);
+	clk_bulk_disable_unprepare(cp->num_clks, cp->clks);
+	regulator_bulk_disable(ARRAY_SIZE(cp->supplies), cp->supplies);
+	pm_runtime_put(&pdev->dev);
+	for (i = 0; i < NUM_BUSES; i++)
+		if (cp->buses[i])
+			i2c_put_adapter(cp->buses[i]);
+	dev_info(&pdev->dev, "cameras powered off\n");
+}
+
+static const struct of_device_id camprobe_of_match[] = {
+	{ .compatible = "luma,camera-probe" },
+	{ }
+};
+
+static struct platform_driver camprobe_driver = {
+	.probe = camprobe_probe,
+	.remove = camprobe_remove,
+	.driver = {
+		.name = "luma-camprobe",
+		.of_match_table = camprobe_of_match,
+	},
+};
+module_platform_driver(camprobe_driver);
+
+MODULE_DESCRIPTION("Camera bring-up: vendor power sequence and chip-id read per sensor");
+MODULE_LICENSE("GPL");
