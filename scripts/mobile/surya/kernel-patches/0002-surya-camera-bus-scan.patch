diff --git a/drivers/media/i2c/luma-camprobe.c b/drivers/media/i2c/luma-camprobe.c
new file mode 100644
index 0000000..a803c42
--- /dev/null
+++ b/drivers/media/i2c/luma-camprobe.c
@@ -0,0 +1,156 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Camera bring-up probe for boards whose sensors have no driver yet: power
+ * every camera module described in the device tree (supplies, MCLKs, reset
+ * and enable lines), scan the listed CCI/I2C buses and log every address
+ * that answers, with a few common chip-id registers, then power off again.
+ * It never writes sensor registers. Load it, read dmesg, unload it.
+ */
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+
+#define CAMPROBE_MCLK_HZ	24000000
+
+static const char * const camprobe_supplies[] = { "vio", "vdig-main", "vdig", "mipi-switch" };
+
+struct camprobe {
+	struct device *dev;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(camprobe_supplies)];
+	struct clk_bulk_data *clks;
+	int num_clks;
+	struct gpio_descs *resets;
+	struct gpio_descs *enables;
+};
+
+static int camprobe_read(struct i2c_adapter *adap, u16 addr, u16 reg, bool reg16,
+			 u8 *val, int len)
+{
+	u8 r[2] = { reg >> 8, reg & 0xff };
+	struct i2c_msg msgs[2] = {
+		{ .addr = addr, .flags = 0, .len = reg16 ? 2 : 1, .buf = reg16 ? r : &r[1] },
+		{ .addr = addr, .flags = I2C_M_RD, .len = len, .buf = val },
+	};
+
+	return i2c_transfer(adap, msgs, 2) == 2 ? 0 : -EIO;
+}
+
+static void camprobe_scan(struct camprobe *cp, struct device_node *bus)
+{
+	struct i2c_adapter *adap = of_find_i2c_adapter_by_node(bus);
+	u8 a[2], b[2], c[2];
+	int addr, found = 0;
+
+	if (!adap) {
+		dev_info(cp->dev, "%pOF: no adapter (bus disabled?)\n", bus);
+		return;
+	}
+	for (addr = 0x08; addr < 0x78; addr++) {
+		if (!camprobe_read(adap, addr, 0x0000, true, a, 2)) {
+			memset(b, 0xff, 2); memset(c, 0xff, 2);
+			camprobe_read(adap, addr, 0x0016, true, b, 2);
+			camprobe_read(adap, addr, 0x0716, true, c, 2);
+			dev_info(cp->dev, "%pOF: 0x%02x answers: [0x0000]=%02x%02x [0x0016]=%02x%02x [0x0716]=%02x%02x\n",
+				 bus, addr, a[0], a[1], b[0], b[1], c[0], c[1]);
+			found++;
+		} else if (!camprobe_read(adap, addr, 0x02, false, a, 2)) {
+			dev_info(cp->dev, "%pOF: 0x%02x answers (8-bit regs): [0x02]=%02x [0x03]=%02x\n",
+				 bus, addr, a[0], a[1]);
+			found++;
+		}
+	}
+	dev_info(cp->dev, "%pOF: %d address(es) answered\n", bus, found);
+	i2c_put_adapter(adap);
+}
+
+static int camprobe_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct camprobe *cp;
+	struct of_phandle_iterator it;
+	int i, ret;
+
+	cp = devm_kzalloc(dev, sizeof(*cp), GFP_KERNEL);
+	if (!cp)
+		return -ENOMEM;
+	cp->dev = dev;
+
+	for (i = 0; i < ARRAY_SIZE(camprobe_supplies); i++)
+		cp->supplies[i].supply = camprobe_supplies[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(cp->supplies), cp->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "supplies\n");
+	cp->num_clks = devm_clk_bulk_get_all(dev, &cp->clks);
+	if (cp->num_clks < 0)
+		return dev_err_probe(dev, cp->num_clks, "clocks\n");
+	cp->resets = devm_gpiod_get_array_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(cp->resets))
+		return dev_err_probe(dev, PTR_ERR(cp->resets), "reset gpios\n");
+	cp->enables = devm_gpiod_get_array_optional(dev, "enable", GPIOD_OUT_LOW);
+	if (IS_ERR(cp->enables))
+		return dev_err_probe(dev, PTR_ERR(cp->enables), "enable gpios\n");
+
+	devm_pm_runtime_enable(dev);
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "power domain\n");
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(cp->supplies), cp->supplies);
+	if (ret) {
+		dev_err(dev, "enable supplies: %d\n", ret);
+		goto put_pm;
+	}
+	for (i = 0; i < cp->num_clks; i++)
+		clk_set_rate(cp->clks[i].clk, CAMPROBE_MCLK_HZ);
+	ret = clk_bulk_prepare_enable(cp->num_clks, cp->clks);
+	if (ret) {
+		dev_err(dev, "enable mclks: %d\n", ret);
+		goto supplies_off;
+	}
+	for (i = 0; cp->enables && i < cp->enables->ndescs; i++)
+		gpiod_set_value_cansleep(cp->enables->desc[i], 1);
+	usleep_range(2000, 3000);
+	for (i = 0; cp->resets && i < cp->resets->ndescs; i++)
+		gpiod_set_value_cansleep(cp->resets->desc[i], 0);
+	msleep(30);
+
+	dev_info(dev, "cameras powered (%d mclks at %u Hz), scanning\n",
+		 cp->num_clks, CAMPROBE_MCLK_HZ);
+	of_for_each_phandle(&it, ret, dev->of_node, "luma,i2c-buses", NULL, 0)
+		camprobe_scan(cp, it.node);
+
+	for (i = 0; cp->resets && i < cp->resets->ndescs; i++)
+		gpiod_set_value_cansleep(cp->resets->desc[i], 1);
+	for (i = 0; cp->enables && i < cp->enables->ndescs; i++)
+		gpiod_set_value_cansleep(cp->enables->desc[i], 0);
+	clk_bulk_disable_unprepare(cp->num_clks, cp->clks);
+supplies_off:
+	regulator_bulk_disable(ARRAY_SIZE(cp->supplies), cp->supplies);
+put_pm:
+	pm_runtime_put(dev);
+	dev_info(dev, "cameras powered off\n");
+	return 0;
+}
+
+static const struct of_device_id camprobe_of_match[] = {
+	{ .compatible = "luma,camera-probe" },
+	{ }
+};
+
+static struct platform_driver camprobe_driver = {
+	.probe = camprobe_probe,
+	.driver = {
+		.name = "luma-camprobe",
+		.of_match_table = camprobe_of_match,
+	},
+};
+module_platform_driver(camprobe_driver);
+
+MODULE_DESCRIPTION("Camera bring-up bus scan for sensors without a driver");
+MODULE_LICENSE("GPL");
