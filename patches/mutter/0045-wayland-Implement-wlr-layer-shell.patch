+typedef enum
+{
+  META_LAYER_SHELL_CAPABILITY_NONE = 0,
+  META_LAYER_SHELL_CAPABILITY_BACKGROUND = 1 << 0,
+  META_LAYER_SHELL_CAPABILITY_PANEL = 1 << 1,
+  META_LAYER_SHELL_CAPABILITY_OVERLAY = 1 << 2,
+  META_LAYER_SHELL_CAPABILITY_KEYBOARD = 1 << 3,
+} MetaLayerShellCapabilities;
