+/* Limits */
+
+static void
+set_actor_tree_reactive (ClutterActor *actor,
+                         gboolean      reactive)
+{
+  ClutterActor *child;
+
+  if (META_IS_SURFACE_ACTOR (actor))
+    clutter_actor_set_reactive (actor, reactive);
+
+  for (child = clutter_actor_get_first_child (actor);
+       child;
+       child = clutter_actor_get_next_sibling (child))
+    set_actor_tree_reactive (child, reactive);
+}
+
+static void
+remove_fade_effect (ClutterTransition *transition,
+                    gboolean           finished,
+                    ClutterActor      *actor)
+{
+  ClutterEffect *effect = clutter_actor_get_effect (actor, "luma-layer-fade");
+
+  if (finished && effect &&
+      clutter_desaturate_effect_get_factor (CLUTTER_DESATURATE_EFFECT (effect)) <= 0.0)
+    clutter_actor_remove_effect (actor, effect);
+}
+
+static void
+layer_surface_set_dimmed (MetaWaylandLayerSurface *layer_surface,
+                          MetaWindow              *window,
+                          gboolean                 dimmed)
+{
+  MetaWindowActor *window_actor = meta_window_actor_from_window (window);
+  ClutterActor *actor;
+  ClutterEffect *effect;
+  ClutterTransition *transition;
+  double from;
+
+  if (!window_actor)
+    return;
+
+  actor = CLUTTER_ACTOR (window_actor);
+
+  /* Input passes through a faded surface; kept in step on every update,
+   * since a commit can bring new subsurface actors. */
+  set_actor_tree_reactive (actor, !dimmed);
+
+  if (dimmed == layer_surface->dimmed)
+    return;
+
+  meta_topic (META_DEBUG_WAYLAND, "Layer surface %s of %s %s",
+              layer_surface_describe (layer_surface),
+              layer_surface_app (layer_surface),
+              dimmed ? "faded: its app does not have the focus" : "shown");
+  layer_surface->dimmed = dimmed;
+
+  clutter_actor_save_easing_state (actor);
+  clutter_actor_set_easing_mode (actor, CLUTTER_EASE_OUT_CUBIC);
+  clutter_actor_set_easing_duration (actor, LAYER_FADE_MS);
+  clutter_actor_set_opacity (actor, dimmed ? LAYER_FADED_OPACITY : 255);
+  clutter_actor_restore_easing_state (actor);
+
+  effect = clutter_actor_get_effect (actor, "luma-layer-fade");
+  if (!effect)
+    {
+      effect = clutter_desaturate_effect_new (0.0);
+      clutter_actor_add_effect_with_name (actor, "luma-layer-fade", effect);
+    }
+  from = clutter_desaturate_effect_get_factor (CLUTTER_DESATURATE_EFFECT (effect));
+
+  clutter_actor_remove_transition (actor, "luma-layer-fade");
+  transition = clutter_property_transition_new_for_actor (actor,
+                                                          "@effects.luma-layer-fade.factor");
+  clutter_timeline_set_duration (CLUTTER_TIMELINE (transition), LAYER_FADE_MS);
+  clutter_timeline_set_progress_mode (CLUTTER_TIMELINE (transition),
+                                      CLUTTER_EASE_OUT_CUBIC);
+  clutter_transition_set_from (transition, G_TYPE_DOUBLE, from);
+  clutter_transition_set_to (transition, G_TYPE_DOUBLE,
+                             dimmed ? 1.0 - LAYER_FADED_SATURATION : 0.0);
+  g_signal_connect_object (transition, "stopped",
+                           G_CALLBACK (remove_fade_effect), actor, 0);
+  clutter_actor_add_transition (actor, "luma-layer-fade", transition);
+  g_object_unref (transition);
+}
+
+static double
+layer_surface_get_coverage (MetaWaylandLayerSurface *layer_surface,
+                            MetaWindow              *window,
+                            MetaLogicalMonitor      *logical_monitor)
+{
+  MtkRectangle rect, visible;
+  const MtkRectangle *output = &logical_monitor->rect;
+  double area = (double) output->width * output->height;
+
+  meta_window_get_frame_rect (window, &rect);
+  if (area <= 0 || !mtk_rectangle_intersect (&rect, output, &visible))
+    return 0.0;
+
+  return (double) visible.width * visible.height / area;
+}
+
+/* Inside a band along one edge of its output, LAYER_PANEL_BAND of the short
+ * side deep. */
+static gboolean
+rect_in_edge_band (const MtkRectangle *rect,
+                   const MtkRectangle *output)
+{
+  int depth = (int) (MIN (output->width, output->height) * LAYER_PANEL_BAND);
+
+  if (rect->x < output->x || rect->y < output->y ||
+      rect->x + rect->width > output->x + output->width ||
+      rect->y + rect->height > output->y + output->height)
+    return FALSE;
+
+  return rect->y + rect->height <= output->y + depth ||
+         rect->y >= output->y + output->height - depth ||
+         rect->x + rect->width <= output->x + depth ||
+         rect->x >= output->x + output->width - depth;
+}
+
+static gboolean
+layer_surface_is_exempt (MetaWaylandLayerSurface *layer_surface,
+                         MetaWindow              *window,
+                         MetaLogicalMonitor      *logical_monitor)
+{
+  MtkRectangle rect;
+
+  if (layer_surface->is_shell ||
+      layer_surface->current.layer == LAYER_BACKGROUND)
+    return TRUE;
+
+  if (layer_surface->current.layer == LAYER_OVERLAY)
+    return FALSE;
+
+  meta_window_get_frame_rect (window, &rect);
+  return rect_in_edge_band (&rect, &logical_monitor->rect);
+}
+
+/* Its application, or the full-screen window it is drawn over, has the
+ * focus. */
+static gboolean
+layer_surface_has_its_turn (MetaWaylandLayerSurface *layer_surface,
+                            MetaWindow              *focus_window,
+                            MetaLogicalMonitor      *logical_monitor)
+{
+  if (!focus_window)
+    return FALSE;
+
+  if (layer_surface->pid > 0 &&
+      meta_window_get_pid (focus_window) == layer_surface->pid)
+    return TRUE;
+
+  if (layer_surface->app_id &&
+      g_strcmp0 (meta_window_get_sandboxed_app_id (focus_window),
+                 layer_surface->app_id) == 0)
+    return TRUE;
+
+  return meta_window_is_fullscreen (focus_window) &&
+         meta_window_get_main_logical_monitor (focus_window) == logical_monitor;
+}
+
+static gboolean layer_shell_update_limits_cb (gpointer user_data);
+
+/* Surfaces of one application on one output count together; without an
+ * application ID, those of one process. */
+static char *
+layer_surface_coverage_key (MetaWaylandLayerSurface *layer_surface,
+                            MetaLogicalMonitor      *logical_monitor)
+{
+  if (layer_surface->app_id)
+    return g_strdup_printf ("%s\x1f%d", layer_surface->app_id,
+                            logical_monitor->number);
+
+  return g_strdup_printf ("\x1f%d\x1f%d", layer_surface->pid,
+                          logical_monitor->number);
+}
+
+static void
+add_app (GPtrArray  *apps,
+         const char *app)
+{
+  if (!g_ptr_array_find_with_equal_func (apps, app, g_str_equal, NULL))
+    g_ptr_array_add (apps, g_strdup (app));
+}
+
+static void
+layer_shell_update_overlay_apps (MetaWaylandLayerShell *layer_shell)
+{
+  g_autoptr (GPtrArray) overlay = g_ptr_array_new_with_free_func (g_free);
+  g_autoptr (GPtrArray) dimmed = g_ptr_array_new_with_free_func (g_free);
+  GList *l;
+
+  for (l = layer_shell->surfaces; l && !layer_shell->suspended; l = l->next)
+    {
+      MetaWaylandLayerSurface *layer_surface = l->data;
+
+      if (!layer_surface->mapped || layer_surface->closed ||
+          layer_surface->is_shell)
+        continue;
+
+      if (layer_surface->current.layer == LAYER_OVERLAY)
+        add_app (overlay, layer_surface_app (layer_surface));
+      if (layer_surface->dimmed)
+        add_app (dimmed, layer_surface_app (layer_surface));
+    }
+
+  g_ptr_array_unref (layer_shell->overlay_apps);
+  layer_shell->overlay_apps = g_steal_pointer (&overlay);
+  g_ptr_array_unref (layer_shell->dimmed_apps);
+  layer_shell->dimmed_apps = g_steal_pointer (&dimmed);
+}
+
+/* (app, namespace, layer, capabilities in use, faded, held, mapped since) for
+ * every surface past its initial commit. */
+static GVariant *
+layer_shell_build_state (MetaWaylandLayerShell *layer_shell)
+{
+  GVariantBuilder builder;
+  GList *l;
+
+  g_variant_builder_init (&builder, G_VARIANT_TYPE ("a(ssuubbt)"));
+  for (l = layer_shell->surfaces; l; l = l->next)
+    {
+      MetaWaylandLayerSurface *layer_surface = l->data;
+      gboolean shown = layer_surface->mapped && !layer_shell->suspended;
+
+      if (layer_surface->is_shell || layer_surface->closed ||
+          !layer_surface->initialized || (!shown && !layer_surface->held))
+        continue;
+
+      g_variant_builder_add (&builder, "(ssuubbt)",
+                             layer_surface_app (layer_surface),
+                             layer_surface->namespace ? layer_surface->namespace : "",
+                             layer_surface->held ? layer_surface->committed.layer
+                                                 : layer_surface->current.layer,
+                             shown ? (guint) layer_state_needs (&layer_surface->current) : 0u,
+                             shown && layer_surface->dimmed,
+                             layer_surface->held,
+                             (guint64) (shown ? layer_surface->mapped_since / G_USEC_PER_SEC : 0));
+    }
+
+  return g_variant_ref_sink (g_variant_builder_end (&builder));
+}
+
+static void
+layer_shell_update_state (MetaWaylandLayerShell *layer_shell)
+{
+  g_autoptr (GVariant) state = NULL;
+
+  layer_shell_update_overlay_apps (layer_shell);
+
+  state = layer_shell_build_state (layer_shell);
+  if (layer_shell->state && g_variant_equal (state, layer_shell->state))
+    return;
+
+  g_clear_pointer (&layer_shell->state, g_variant_unref);
+  layer_shell->state = g_steal_pointer (&state);
+  g_signal_emit_by_name (layer_shell->compositor,
+                         "layer-shell-surfaces-changed");
+}
+
+/**
+ * meta_wayland_compositor_get_layer_shell_surfaces:
+ * @compositor: a #MetaWaylandCompositor
+ *
+ * Every application layer surface on screen or held back by its grants, as
+ * a(ssuubbt): application ID, namespace, layer (0 background ... 3 overlay;
+ * the layer asked for when held), the #MetaLayerShellCapabilities it is
+ * using (0 when held or hidden), whether it is faded by the coverage limit,
+ * whether it is held back waiting for a grant, and when it was mapped (Unix
+ * seconds; 0 when not shown). "layer-shell-surfaces-changed" says when this
+ * changes.
+ *
+ * Returns: (transfer full): the surfaces
+ */
+GVariant *
+meta_wayland_compositor_get_layer_shell_surfaces (MetaWaylandCompositor *compositor)
+{
+  MetaWaylandLayerShell *layer_shell;
+
+  g_return_val_if_fail (META_IS_WAYLAND_COMPOSITOR (compositor), NULL);
+
+  layer_shell = layer_shell_from_compositor (compositor);
+  if (!layer_shell)
+    return g_variant_ref_sink (g_variant_new_array (G_VARIANT_TYPE ("(ssuubbt)"), NULL, 0));
+
+  if (!layer_shell->state)
+    layer_shell->state = layer_shell_build_state (layer_shell);
+
+  return g_variant_ref (layer_shell->state);
+}
+
+static void
+layer_shell_update_limits (MetaWaylandLayerShell *layer_shell)
+{
+  MetaDisplay *display = layer_shell_get_display (layer_shell);
+  MetaWindow *focus_window = display ? meta_display_get_focus_window (display) : NULL;
+  int64_t now = g_get_monotonic_time ();
+  int64_t next = 0;
+  GList *l;
+
+  g_autoptr (GHashTable) totals =
+    g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_free);
+
+  g_clear_handle_id (&layer_shell->limits_timeout_id, g_source_remove);
+
+  /* An application's surfaces on one output count together. */
+  for (l = layer_shell->surfaces; l; l = l->next)
+    {
+      MetaWaylandLayerSurface *layer_surface = l->data;
+      MetaWindow *window = layer_surface_get_window (layer_surface);
+      MetaLogicalMonitor *logical_monitor;
+      char *key;
+      double *total;
+
+      if (!window || !layer_surface->mapped)
+        continue;
+
+      logical_monitor = layer_surface_get_logical_monitor (layer_surface);
+      if (!logical_monitor ||
+          layer_surface_is_exempt (layer_surface, window, logical_monitor))
+        continue;
+
+      key = layer_surface_coverage_key (layer_surface, logical_monitor);
+      total = g_hash_table_lookup (totals, key);
+      if (!total)
+        {
+          total = g_new0 (double, 1);
+          g_hash_table_insert (totals, g_strdup (key), total);
+        }
+      *total += layer_surface_get_coverage (layer_surface, window, logical_monitor);
+      g_free (key);
+    }
+
+  for (l = layer_shell->surfaces; l; l = l->next)
+    {
+      MetaWaylandLayerSurface *layer_surface = l->data;
+      MetaWindow *window = layer_surface_get_window (layer_surface);
+      MetaLogicalMonitor *logical_monitor;
+      gboolean shown = TRUE;
+      double *total = NULL;
+
+      if (!window || !layer_surface->mapped)
+        continue;
+
+      logical_monitor = layer_surface_get_logical_monitor (layer_surface);
+      if (!logical_monitor)
+        continue;
+
+      if (!layer_surface_is_exempt (layer_surface, window, logical_monitor))
+        {
+          g_autofree char *key =
+            layer_surface_coverage_key (layer_surface, logical_monitor);
+
+          total = g_hash_table_lookup (totals, key);
+        }
+
+      layer_surface->limited = total && *total > LAYER_MAX_COVERAGE;
+
+      if (layer_surface->limited)
+        {
+          int64_t action = window->layer_shell_last_action_us;
+
+          shown = layer_surface_has_its_turn (layer_surface, focus_window,
+                                              logical_monitor);
+          if (action && now - action < LAYER_ACTION_GRACE_US)
+            {
+              shown = TRUE;
+              if (!next || action + LAYER_ACTION_GRACE_US < next)
+                next = action + LAYER_ACTION_GRACE_US;
+            }
+        }
+
+      layer_surface_set_dimmed (layer_surface, window, !shown);
+    }
+
+  if (next)
+    {
+      layer_shell->limits_timeout_id =
+        g_timeout_add (MAX (1, (next - now) / 1000) + 1,
+                       layer_shell_update_limits_cb, layer_shell);
+    }
+
+  layer_shell_update_state (layer_shell);
+}
+
+static gboolean
+layer_shell_update_limits_cb (gpointer user_data)
+{
+  MetaWaylandLayerShell *layer_shell = user_data;
+
+  layer_shell->limits_timeout_id = 0;
+  layer_shell_update_limits (layer_shell);
+  return G_SOURCE_REMOVE;
+}
+
+/* An overlay that covers most of the screen as soon as its app starts is
+ * how a fake login or system screen opens. */
+static gboolean
+layer_surface_breaks_startup_guard (MetaWaylandLayerSurface *layer_surface)
+{
+  MetaWindow *window = layer_surface_get_window (layer_surface);
+  MetaLogicalMonitor *logical_monitor =
+    layer_surface_get_logical_monitor (layer_surface);
+  int64_t age;
+  double coverage;
+
+  if (layer_surface->is_shell || !window || !logical_monitor ||
+      layer_surface->current.layer != LAYER_OVERLAY ||
+      layer_surface->start_time_us <= 0)
+    return FALSE;
+
+  age = meta_wayland_client_identity_now_us () - layer_surface->start_time_us;
+  coverage = layer_surface_get_coverage (layer_surface, window, logical_monitor);
+  if (age >= LAYER_STARTUP_GUARD_US || coverage <= LAYER_MAX_COVERAGE)
+    return FALSE;
+
+  g_message ("Layer surface \"%s\" of %s refused: an overlay covering %d%% "
+             "of its output %d ms after the app started",
+             layer_surface_describe (layer_surface),
+             layer_surface_app (layer_surface),
+             (int) (coverage * 100), (int) (age / 1000));
+  return TRUE;
+}
+
+/**
+ * meta_wayland_compositor_set_layer_surfaces_hidden:
+ * @compositor: a #MetaWaylandCompositor
+ * @hidden: whether layer surfaces are put away
+ *
+ * Hidden layer surfaces, and their popups, are not shown, get no pointer or
+ * touch input and never hold the keyboard. The Shell hides them while the
+ * session is locked.
+ */
+void
+meta_wayland_compositor_set_layer_surfaces_hidden (MetaWaylandCompositor *compositor,
+                                                   gboolean               hidden)
+{
+  MetaWaylandLayerShell *layer_shell;
+  MetaDisplay *display;
+  GList *windows, *l;
+
+  g_return_if_fail (META_IS_WAYLAND_COMPOSITOR (compositor));
+
+  layer_shell = layer_shell_from_compositor (compositor);
+  if (!layer_shell || layer_shell->suspended == !!hidden)
+    return;
+
+  layer_shell->suspended = !!hidden;
+
+  display = layer_shell_get_display (layer_shell);
+  if (!display)
+    return;
+
+  display->layer_surfaces_hidden = layer_shell->suspended;
+
+  meta_topic (META_DEBUG_WAYLAND, "Layer surfaces %s",
+              hidden ? "hidden" : "shown");
+
+  windows = meta_display_list_all_windows (display);
+  for (l = windows; l; l = l->next)
+    {
+      MetaWindow *window = l->data;
+
+      if (meta_window_find_root_ancestor (window)->is_layer_surface)
+        meta_window_queue (window, META_QUEUE_CALC_SHOWING);
+    }
+  g_list_free (windows);
+
+  layer_shell_update_state (layer_shell);
+  if (!hidden)
+    layer_shell_sync_keyboard_focus (layer_shell);
+}
