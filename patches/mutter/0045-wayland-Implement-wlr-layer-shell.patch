+/* Shell surface */
+
+static void
+meta_wayland_layer_surface_configure (MetaWaylandShellSurface        *shell_surface,
+                                      MetaWaylandWindowConfiguration *configuration)
+{
+  /* A layer surface's size comes from its anchors, margins and the work
+   * area; it is sent as zwlr_layer_surface_v1.configure by the arrangement,
+   * never as a window configuration. */
+}
+
+static void
+meta_wayland_layer_surface_managed (MetaWaylandShellSurface *shell_surface,
+                                    MetaWindow              *window)
+{
+  MetaWaylandLayerSurface *layer_surface =
+    META_WAYLAND_LAYER_SURFACE (shell_surface);
+
+  /* The window is still being constructed: what the compositor and the
+   * stack read when it is added. layer_surface_create_window() does the
+   * rest. */
+  window->is_layer_surface = TRUE;
+  window->layer_shell_layer = layer_surface->current.layer;
+  window->type = window_type_for_layer (layer_surface->current.layer);
+  window->input = layer_surface->current.keyboard_interactivity !=
+                  ZWLR_LAYER_SURFACE_V1_KEYBOARD_INTERACTIVITY_NONE;
+}
+
+static void
+meta_wayland_layer_surface_ping (MetaWaylandShellSurface *shell_surface,
+                                 uint32_t                 serial)
+{
+  MetaWaylandLayerSurface *layer_surface =
+    META_WAYLAND_LAYER_SURFACE (shell_surface);
+
+  /* The protocol has no ping: answer for it. */
+  if (layer_surface->layer_shell)
+    meta_display_pong_for_serial (layer_shell_get_display (layer_surface->layer_shell),
+                                  serial);
+}
