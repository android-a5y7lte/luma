+static void
+meta_wayland_layer_surface_shell_close (MetaWaylandShellSurface *shell_surface)
+{
+  layer_surface_close (META_WAYLAND_LAYER_SURFACE (shell_surface));
+}
+
+static void
+meta_wayland_layer_surface_dispose (GObject *object)
+{
+  MetaWaylandLayerSurface *layer_surface = META_WAYLAND_LAYER_SURFACE (object);
+  MetaWaylandLayerShell *layer_shell = layer_surface->layer_shell;
+  gboolean reserved = layer_surface->mapped &&
+                      layer_state_reserves (&layer_surface->current);
+
+  if (layer_surface->output)
+    g_clear_signal_handler (&layer_surface->output_destroyed_id,
+                            layer_surface->output);
+  layer_surface->output = NULL;
+
+  if (layer_surface->resource)
+    wl_resource_set_user_data (layer_surface->resource, NULL);
+  layer_surface->resource = NULL;
+
+  layer_surface_reset (layer_surface);
+  layer_surface_detach (layer_surface);
+  layer_surface->mapped = FALSE;
+
+  /* The wl_surface can go first (a client that quits): what it reserved
+   * and covered goes with it. */
+  if (layer_shell)
+    {
+      if (reserved)
+        layer_shell_invalidate_work_areas (layer_shell);
+      layer_shell_arrange (layer_shell);
+    }
+
+  G_OBJECT_CLASS (meta_wayland_layer_surface_parent_class)->dispose (object);
+}
+
+static void
+meta_wayland_layer_surface_finalize (GObject *object)
+{
+  MetaWaylandLayerSurface *layer_surface = META_WAYLAND_LAYER_SURFACE (object);
+
+  g_free (layer_surface->namespace);
+  g_free (layer_surface->app_id);
+
+  G_OBJECT_CLASS (meta_wayland_layer_surface_parent_class)->finalize (object);
+}
+
+static void
+meta_wayland_layer_surface_init (MetaWaylandLayerSurface *layer_surface)
+{
+  layer_surface->monitor_number = -1;
+}
+
+static void
+meta_wayland_layer_surface_class_init (MetaWaylandLayerSurfaceClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  MetaWaylandSurfaceRoleClass *surface_role_class =
+    META_WAYLAND_SURFACE_ROLE_CLASS (klass);
+  MetaWaylandShellSurfaceClass *shell_surface_class =
+    META_WAYLAND_SHELL_SURFACE_CLASS (klass);
+
+  object_class->dispose = meta_wayland_layer_surface_dispose;
+  object_class->finalize = meta_wayland_layer_surface_finalize;
+
+  surface_role_class->commit_state = meta_wayland_layer_surface_commit_state;
+  surface_role_class->apply_state = meta_wayland_layer_surface_apply_state;
+  surface_role_class->get_toplevel = meta_wayland_layer_surface_get_toplevel;
+  surface_role_class->is_on_logical_monitor =
+    meta_wayland_layer_surface_is_on_logical_monitor;
+
+  shell_surface_class->configure = meta_wayland_layer_surface_configure;
+  shell_surface_class->managed = meta_wayland_layer_surface_managed;
+  shell_surface_class->ping = meta_wayland_layer_surface_ping;
+  shell_surface_class->close = meta_wayland_layer_surface_shell_close;
+}
+
+/* zwlr_layer_shell_v1 */
+
+static void
+on_output_destroyed (MetaWaylandOutput       *output,
+                     MetaWaylandLayerSurface *layer_surface)
+{
+  g_clear_signal_handler (&layer_surface->output_destroyed_id, output);
+  layer_surface->output = NULL;
+
+  /* Its output is gone: the client decides where to go next. */
+  layer_surface_close (layer_surface);
+}
+
+static void ensure_display_signals (MetaWaylandLayerShell *layer_shell);
+
+static void
+layer_shell_get_layer_surface (struct wl_client   *client,
+                               struct wl_resource *resource,
+                               uint32_t            id,
+                               struct wl_resource *surface_resource,
+                               struct wl_resource *output_resource,
+                               uint32_t            layer,
+                               const char         *namespace)
+{
+  MetaWaylandLayerShell *layer_shell = wl_resource_get_user_data (resource);
+  MetaWaylandSurface *surface = wl_resource_get_user_data (surface_resource);
+  const MetaWaylandClientIdentity *identity =
+    meta_wayland_client_get_identity (client);
+  MetaWaylandLayerSurface *layer_surface;
+  struct wl_resource *layer_surface_resource;
+  pid_t pid = 0;
+  uid_t uid;
+  gid_t gid;
+
+  if (layer > LAYER_OVERLAY)
+    {
+      wl_resource_post_error (resource, ZWLR_LAYER_SHELL_V1_ERROR_INVALID_LAYER,
+                              "invalid layer %u", layer);
+      return;
+    }
+
+  if (meta_wayland_surface_get_buffer (surface) || surface->buffer)
+    {
+      wl_resource_post_error (resource,
+                              ZWLR_LAYER_SHELL_V1_ERROR_ALREADY_CONSTRUCTED,
+                              "wl_surface@%u already has a buffer",
+                              wl_resource_get_id (surface_resource));
+      return;
+    }
+
+  if (!meta_wayland_surface_assign_role (surface,
+                                         META_TYPE_WAYLAND_LAYER_SURFACE,
+                                         NULL))
+    {
+      wl_resource_post_error (resource, ZWLR_LAYER_SHELL_V1_ERROR_ROLE,
+                              "wl_surface@%u already has another role",
+                              wl_resource_get_id (surface_resource));
+      return;
+    }
+
+  layer_surface = META_WAYLAND_LAYER_SURFACE (surface->role);
+  layer_surface->layer_shell = layer_shell;
+  layer_surface->namespace = g_strdup (namespace);
+  layer_surface->pending.layer = layer;
+  layer_surface->committed = layer_surface->pending;
+  layer_surface->current = layer_surface->pending;
+
+  wl_client_get_credentials (client, &pid, &uid, &gid);
+  layer_surface->pid = pid;
+  layer_surface->app_id = g_strdup (identity->app_id);
+  layer_surface->is_shell = identity->is_shell;
+  layer_surface->sandboxed = identity->sandboxed;
+  layer_surface->start_time_us = identity->start_time_us;
+  ensure_display_signals (layer_shell);
+
+  if (output_resource)
+    {
+      layer_surface->had_output = TRUE;
+      layer_surface->output = wl_resource_get_user_data (output_resource);
+      if (layer_surface->output)
+        {
+          layer_surface->output_destroyed_id =
+            g_signal_connect (layer_surface->output, "output-destroyed",
+                              G_CALLBACK (on_output_destroyed),
+                              layer_surface);
+        }
+    }
+
+  layer_surface_resource = wl_resource_create (client,
+                                               &zwlr_layer_surface_v1_interface,
+                                               wl_resource_get_version (resource),
+                                               id);
+  wl_resource_set_implementation (layer_surface_resource,
+                                  &layer_surface_interface,
+                                  layer_surface,
+                                  layer_surface_resource_destroyed);
+  layer_surface->resource = layer_surface_resource;
+
+  layer_shell->surfaces = g_list_append (layer_shell->surfaces, layer_surface);
+
+  /* An output that is already gone. */
+  if (output_resource && !layer_surface->output)
+    layer_surface_close (layer_surface);
+}
+
+static void
+layer_shell_destroy (struct wl_client   *client,
+                     struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static const struct zwlr_layer_shell_v1_interface layer_shell_interface = {
+  .get_layer_surface = layer_shell_get_layer_surface,
+  .destroy = layer_shell_destroy,
+};
+
+static void
+bind_layer_shell (struct wl_client *client,
+                  void             *data,
+                  uint32_t          version,
+                  uint32_t          id)
+{
+  MetaWaylandLayerShell *layer_shell = data;
+  struct wl_resource *resource;
+
+  resource = wl_resource_create (client, &zwlr_layer_shell_v1_interface,
+                                 version, id);
+  wl_resource_set_implementation (resource, &layer_shell_interface,
+                                  layer_shell, NULL);
+}
+
+static void
+on_monitors_changed (MetaMonitorManager    *monitor_manager,
+                     MetaWaylandLayerShell *layer_shell)
+{
+  GList *l;
+
+  /* A compositor-picked monitor that is gone falls back to the primary. */
+  for (l = layer_shell->surfaces; l; l = l->next)
+    {
+      MetaWaylandLayerSurface *layer_surface = l->data;
+
+      if (layer_surface->monitor_number >= 0 &&
+          !meta_monitor_manager_get_logical_monitor_from_number (monitor_manager,
+                                                                 layer_surface->monitor_number))
+        layer_surface->monitor_number = -1;
+    }
+
+  layer_shell_invalidate_work_areas (layer_shell);
+  layer_shell_arrange (layer_shell);
+}
+
+static void
+on_workareas_changed (MetaDisplay           *display,
+                      MetaWaylandLayerShell *layer_shell)
+{
+  layer_shell_arrange (layer_shell);
+}
+
+static void
+ensure_display_signals (MetaWaylandLayerShell *layer_shell)
+{
+  MetaDisplay *display = layer_shell_get_display (layer_shell);
+
+  if (layer_shell->workareas_changed_id || !display)
+    return;
+
+  layer_shell->workareas_changed_id =
+    g_signal_connect (display, "workareas-changed",
+                      G_CALLBACK (on_workareas_changed), layer_shell);
+  layer_shell->focus_window_id =
+    g_signal_connect (display, "notify::focus-window",
+                      G_CALLBACK (on_focus_window_changed), layer_shell);
+  /* A full-screen window, the game under an overlay, changes its turn. */
+  layer_shell->fullscreen_id =
+    g_signal_connect_swapped (display, "in-fullscreen-changed",
+                              G_CALLBACK (layer_shell_update_limits), layer_shell);
+}
+
+static void
+on_prepare_shutdown (MetaWaylandCompositor *compositor,
+                     MetaWaylandLayerShell *layer_shell)
+{
+  MetaDisplay *display = layer_shell_get_display (layer_shell);
+
+  if (display)
+    {
+      g_clear_signal_handler (&layer_shell->workareas_changed_id, display);
+      g_clear_signal_handler (&layer_shell->focus_window_id, display);
+      g_clear_signal_handler (&layer_shell->fullscreen_id, display);
+    }
+}
+
+void
+meta_wayland_layer_shell_init (MetaWaylandCompositor *compositor)
+{
+  MetaContext *context = meta_wayland_compositor_get_context (compositor);
+  MetaBackend *backend = meta_context_get_backend (context);
+  MetaMonitorManager *monitor_manager =
+    meta_backend_get_monitor_manager (backend);
+  MetaWaylandFilterManager *filter_manager =
+    meta_wayland_compositor_get_filter_manager (compositor);
+  MetaWaylandLayerShell *layer_shell;
+
+  layer_shell = g_new0 (MetaWaylandLayerShell, 1);
+  layer_shell->compositor = compositor;
+  layer_shell->grants = g_hash_table_new_full (g_str_hash, g_str_equal,
+                                               g_free, g_free);
+  layer_shell->reported = g_hash_table_new_full (g_str_hash, g_str_equal,
+                                                 g_free, NULL);
+  layer_shell->overlay_apps = g_ptr_array_new_with_free_func (g_free);
+  layer_shell->dimmed_apps = g_ptr_array_new_with_free_func (g_free);
+  layer_shell->stopped = g_hash_table_new_full (g_str_hash, g_str_equal,
+                                                g_free, NULL);
+  compositor->layer_shell = layer_shell;
+
+  layer_shell->global = wl_global_create (compositor->wayland_display,
+                                          &zwlr_layer_shell_v1_interface,
+                                          META_ZWLR_LAYER_SHELL_V1_VERSION,
+                                          layer_shell, bind_layer_shell);
+  if (!layer_shell->global)
+    g_error ("Failed to register a global wlr-layer-shell object");
+
+  meta_wayland_filter_manager_add_global (filter_manager,
+                                          layer_shell->global,
+                                          filter_layer_shell_global,
+                                          layer_shell);
+
+  layer_shell->monitors_changed_id =
+    g_signal_connect (monitor_manager, "monitors-changed-internal",
+                      G_CALLBACK (on_monitors_changed), layer_shell);
+  g_signal_connect (compositor, "prepare-shutdown",
+                    G_CALLBACK (on_prepare_shutdown), layer_shell);
+
+  if (meta_context_get_display (context))
+    ensure_display_signals (layer_shell);
+}
+
+void
+meta_wayland_layer_shell_finalize (MetaWaylandCompositor *compositor)
+{
+  MetaWaylandLayerShell *layer_shell = compositor->layer_shell;
+  MetaContext *context;
+  MetaBackend *backend;
+  GList *l;
+
+  if (!layer_shell)
+    return;
+
+  context = meta_wayland_compositor_get_context (compositor);
+  backend = meta_context_get_backend (context);
+  g_clear_signal_handler (&layer_shell->monitors_changed_id,
+                          meta_backend_get_monitor_manager (backend));
+
+  for (l = layer_shell->surfaces; l; l = l->next)
+    META_WAYLAND_LAYER_SURFACE (l->data)->layer_shell = NULL;
+  g_clear_list (&layer_shell->surfaces, NULL);
+
+  g_clear_handle_id (&layer_shell->limits_timeout_id, g_source_remove);
+  g_hash_table_destroy (layer_shell->grants);
+  g_hash_table_destroy (layer_shell->reported);
+  g_ptr_array_unref (layer_shell->overlay_apps);
+  g_ptr_array_unref (layer_shell->dimmed_apps);
+  g_hash_table_destroy (layer_shell->stopped);
+  g_clear_pointer (&layer_shell->state, g_variant_unref);
+  g_free (layer_shell);
+  compositor->layer_shell = NULL;
+}
