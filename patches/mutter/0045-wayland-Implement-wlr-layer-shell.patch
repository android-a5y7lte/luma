+/*
+ * Places a layer surface's window at @rect (stage coordinates): the size is
+ * the client's buffer, the position the layer shell's arrangement.
+ */
+void
+meta_window_wayland_set_layer_rect (MetaWindow   *window,
+                                    MtkRectangle  rect)
+{
+  MtkRectangle frame_rect = meta_window_config_get_rect (window->config);
+  MetaMoveResizeFlags flags = META_MOVE_RESIZE_WAYLAND_FINISH_MOVE_RESIZE;
+
+  window->custom_frame_extents = (MetaFrameBorder) { 0 };
+  window->placed = TRUE;
+
+  if (rect.x != frame_rect.x || rect.y != frame_rect.y)
+    flags |= META_MOVE_RESIZE_MOVE_ACTION;
+  if (rect.width != frame_rect.width || rect.height != frame_rect.height)
+    flags |= META_MOVE_RESIZE_RESIZE_ACTION;
+
+  if (!(flags & (META_MOVE_RESIZE_MOVE_ACTION | META_MOVE_RESIZE_RESIZE_ACTION)) &&
+      window->buffer_rect.width == rect.width &&
+      window->buffer_rect.height == rect.height)
+    return;
+
+  meta_window_move_resize_internal (window, flags, META_PLACE_FLAG_NONE,
+                                    rect, NULL);
+}
