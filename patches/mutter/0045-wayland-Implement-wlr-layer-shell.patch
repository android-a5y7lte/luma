+++ b/src/wayland/meta-wayland-layer-shell.c
@@ -0,0 +1,2887 @@
+/*
+ * wlr-layer-shell-unstable-v1 for Mutter.
+ *
+ * Copyright (C) 2026 Project Luma
+ *
+ * Ported from Linux Mint's Muffin (src/wayland/meta-wayland-layer-shell.c,
+ * Copyright (C) 2024 Linux Mint, GPL-2.0-or-later) and informed by
+ * Caellian/mutter-layer-shell (Copyright (C) 2024-2026 Tin Švagelj,
+ * GPL-2.0-or-later). The arrangement follows wlroots'
+ * wlr_scene_layer_surface_v1_configure().
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License as
+ * published by the Free Software Foundation; either version 2 of the
+ * License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful, but
+ * WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+/*
+ * Every mapped layer surface is a MetaWindow, as in Muffin since 6.6: focus,
+ * popups, stacking, stage views and the Shell's window tracking then work as
+ * for any window. Background and bottom surfaces are desktop windows (stack
+ * layers DESKTOP and BOTTOM, below every normal window); top surfaces are
+ * docks (above normal windows, below a fullscreen window on their monitor,
+ * and inside the window group, so below the Shell's chrome); overlay
+ * surfaces are docks whose actors live in the compositor's layer overlay
+ * group, which the Shell stacks above every window and below its system
+ * dialogs, lock screen and on-screen displays.
+ *
+ * The layer shell alone places these windows: constraints, placement and
+ * monitor changes leave them alone (window->is_layer_surface). Exclusive
+ * zones shrink each monitor's work area (workspace.c asks
+ * meta_wayland_layer_shell_apply_exclusive_zones()), so maximized and tiled
+ * windows keep clear of a bar the same way they keep clear of the Shell's
+ * own panel.
+ *
+ * Capabilities. What a client may do with the protocol is granted per
+ * application in four parts (MetaLayerShellCapabilities): BACKGROUND (the
+ * background layer), PANEL (the bottom and top layers, exclusive zones,
+ * on_demand keyboard), OVERLAY (the overlay layer, on_demand keyboard) and
+ * KEYBOARD (exclusive keyboard). Every commit is clamped to the grants:
+ * overlay without OVERLAY goes on top, background without BACKGROUND on
+ * bottom, exclusive keyboard without KEYBOARD becomes on_demand, an exclusive
+ * zone needs a panel layer; a surface left with no layer is closed. Each
+ * clamp is logged once per application and reported once
+ * ("layer-shell-clamped"), so the Shell can offer that capability. Host
+ * clients have BACKGROUND and PANEL unless refused, sandboxed ones nothing
+ * until granted, the Shell's own clients everything
+ * (meta-wayland-client-sandbox.h).
+ *
+ * Limits. A surface covering more than LAYER_MAX_COVERAGE of its output
+ * (background surfaces and panels inside an edge band excepted) is shown
+ * only while its application has the focus, a full-screen window on its
+ * output has it (the game an overlay is attached to), or within
+ * LAYER_ACTION_GRACE_US of a click or touch on it; otherwise it is faded
+ * (LAYER_FADED_OPACITY, LAYER_FADED_SATURATION, over LAYER_FADE_MS) and input
+ * passes through it. An application's surfaces on one output count
+ * together. An overlay surface that covers more than that within
+ * LAYER_STARTUP_GUARD_US of its process starting is refused.
+ */
+
+#include "config.h"
+
+#include "wayland/meta-wayland-layer-shell.h"
+
+#include "backends/meta-backend-private.h"
+#include "backends/meta-logical-monitor-private.h"
+#include "backends/meta-monitor-manager-private.h"
+#include "compositor/compositor-private.h"
+#include "core/display-private.h"
+#include "core/window-private.h"
+#include "core/workspace-private.h"
+#include "meta/meta-workspace-manager.h"
+#include "compositor/meta-surface-actor.h"
+#include "compositor/meta-window-actor-private.h"
+#include "wayland/meta-wayland-client-sandbox.h"
+#include "wayland/meta-wayland-filter-manager.h"
+#include "wayland/meta-wayland-outputs.h"
+#include "wayland/meta-wayland-private.h"
+#include "wayland/meta-wayland-surface-private.h"
+#include "wayland/meta-wayland-versions.h"
+#include "wayland/meta-wayland-xdg-shell.h"
+#include "wayland/meta-window-wayland.h"
+
+#include "wlr-layer-shell-unstable-v1-server-protocol.h"
+
+#define ANCHOR_HORIZONTAL (ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT | \
+                           ZWLR_LAYER_SURFACE_V1_ANCHOR_RIGHT)
+#define ANCHOR_VERTICAL (ZWLR_LAYER_SURFACE_V1_ANCHOR_TOP | \
+                         ZWLR_LAYER_SURFACE_V1_ANCHOR_BOTTOM)
+#define ANCHOR_ALL (ANCHOR_HORIZONTAL | ANCHOR_VERTICAL)
+
+/*
+ * The limits, in one place (README: "Capabilities and limits"). Coverage is
+ * a surface's share of its output's area.
+ */
+#define LAYER_MAX_COVERAGE 0.40      /* more than this is limited */
+#define LAYER_PANEL_BAND 0.15        /* edge band, share of the short side */
+#define LAYER_ACTION_GRACE_US (5 * G_USEC_PER_SEC)
+#define LAYER_STARTUP_GUARD_US (2 * G_USEC_PER_SEC)
+#define LAYER_FADED_OPACITY 89       /* of 255: 0.35 */
+#define LAYER_FADED_SATURATION 0.7
+#define LAYER_FADE_MS 180            /* ease-out, both ways */
+
+#define CAPS_ALL (META_LAYER_SHELL_CAPABILITY_BACKGROUND | \
+                  META_LAYER_SHELL_CAPABILITY_PANEL | \
+                  META_LAYER_SHELL_CAPABILITY_OVERLAY | \
+                  META_LAYER_SHELL_CAPABILITY_KEYBOARD)
+#define CAPS_HOST_DEFAULT (META_LAYER_SHELL_CAPABILITY_BACKGROUND | \
+                           META_LAYER_SHELL_CAPABILITY_PANEL)
+
+enum
+{
+  LAYER_BACKGROUND = ZWLR_LAYER_SHELL_V1_LAYER_BACKGROUND,
+  LAYER_BOTTOM = ZWLR_LAYER_SHELL_V1_LAYER_BOTTOM,
+  LAYER_TOP = ZWLR_LAYER_SHELL_V1_LAYER_TOP,
+  LAYER_OVERLAY = ZWLR_LAYER_SHELL_V1_LAYER_OVERLAY,
+};
+
+typedef struct
+{
+  uint32_t layer;
+  uint32_t anchor;
+  int32_t exclusive_zone;
+  uint32_t exclusive_edge;
+  struct {
+    int32_t top;
+    int32_t right;
+    int32_t bottom;
+    int32_t left;
+  } margin;
+  uint32_t width;
+  uint32_t height;
+  uint32_t keyboard_interactivity;
+} LayerState;
+
+typedef struct
+{
+  uint32_t serial;
+  uint32_t width;
+  uint32_t height;
+} LayerConfigure;
+
+struct _MetaWaylandLayerShell
+{
+  MetaWaylandCompositor *compositor;
+  struct wl_global *global;
+
+  /* Oldest first: exclusive zones stack outwards in creation order. */
+  GList *surfaces;
+
+  /* Application ID -> Grants */
+  GHashTable *grants;
+  /* "APP\x1fWHAT": logged or reported once this session. */
+  GHashTable *reported;
+  /* Application IDs with an overlay surface on screen, and with a surface
+   * dimmed by the limits. */
+  GPtrArray *overlay_apps;
+  GPtrArray *dimmed_apps;
+  /* Application IDs whose overlays the person stopped this session. */
+  GHashTable *stopped;
+  /* What get_layer_shell_surfaces() last reported. */
+  GVariant *state;
+  guint limits_timeout_id;
+
+  gboolean suspended;
+  gboolean syncing_focus;
+
+  gulong monitors_changed_id;
+  gulong workareas_changed_id;
+  gulong focus_window_id;
+  gulong fullscreen_id;
+  gulong active_workspace_id;
+};
+
+struct _MetaWaylandLayerSurface
+{
+  MetaWaylandShellSurface parent;
+
+  struct wl_resource *resource;
+  MetaWaylandLayerShell *layer_shell;
+  char *namespace;
+  char *app_id;
+  gboolean is_shell;
+  gboolean sandboxed;
+  pid_t pid;
+  int64_t start_time_us;
+
+  gboolean limited;   /* Its app covers more than LAYER_MAX_COVERAGE. */
+  gboolean dimmed;    /* Faded by the limit. */
+  gboolean held;      /* Refused by the grants; shown once they allow it. */
+  int64_t mapped_since;  /* g_get_real_time () */
+
+  MetaWaylandOutput *output;
+  gulong output_destroyed_id;
+  gboolean had_output;
+  /* Picked by the compositor when the client named no output. */
+  int monitor_number;
+
+  LayerState pending;
+  LayerState committed;
+  LayerState current;
+
+  GList *configures;     /* LayerConfigure, oldest first */
+  gboolean initialized;  /* The initial commit was answered. */
+  gboolean acked;        /* A configure was acknowledged. */
+  gboolean has_sent_size;
+  uint32_t sent_width;
+  uint32_t sent_height;
+
+  gboolean mapped;
+  gboolean closed;
+
+  MtkRectangle box;      /* Arranged, in stage coordinates. */
+};
+
+G_DEFINE_TYPE (MetaWaylandLayerSurface, meta_wayland_layer_surface,
+               META_TYPE_WAYLAND_SHELL_SURFACE)
+
+static void layer_shell_arrange (MetaWaylandLayerShell *layer_shell);
+static void layer_shell_sync_keyboard_focus (MetaWaylandLayerShell *layer_shell);
+static void layer_shell_update_limits (MetaWaylandLayerShell *layer_shell);
+static void layer_shell_update_state (MetaWaylandLayerShell *layer_shell);
+static void layer_surface_reevaluate (MetaWaylandLayerSurface *layer_surface);
+
+static MetaWaylandLayerShell *
+layer_shell_from_compositor (MetaWaylandCompositor *compositor)
+{
+  return compositor->layer_shell;
+}
+
+static MetaContext *
+layer_shell_get_context (MetaWaylandLayerShell *layer_shell)
+{
+  return meta_wayland_compositor_get_context (layer_shell->compositor);
+}
+
+static MetaDisplay *
+layer_shell_get_display (MetaWaylandLayerShell *layer_shell)
+{
+  return meta_context_get_display (layer_shell_get_context (layer_shell));
+}
+
+static MetaBackend *
+layer_shell_get_backend (MetaWaylandLayerShell *layer_shell)
+{
+  return meta_context_get_backend (layer_shell_get_context (layer_shell));
+}
+
+static MetaWaylandSurface *
+layer_surface_get_surface (MetaWaylandLayerSurface *layer_surface)
+{
+  return meta_wayland_surface_role_get_surface (META_WAYLAND_SURFACE_ROLE (layer_surface));
+}
+
+static MetaWindow *
+layer_surface_get_window (MetaWaylandLayerSurface *layer_surface)
+{
+  return meta_wayland_surface_get_window (layer_surface_get_surface (layer_surface));
+}
+
+static const char *
+layer_surface_describe (MetaWaylandLayerSurface *layer_surface)
+{
+  return layer_surface->namespace ? layer_surface->namespace : "(unnamed)";
+}
+
+/* Monitors */
+
+static MetaLogicalMonitor *
+layer_surface_get_logical_monitor (MetaWaylandLayerSurface *layer_surface)
+{
+  MetaWaylandLayerShell *layer_shell = layer_surface->layer_shell;
+  MetaBackend *backend = layer_shell_get_backend (layer_shell);
+  MetaMonitorManager *monitor_manager =
+    meta_backend_get_monitor_manager (backend);
+  MetaLogicalMonitor *logical_monitor = NULL;
+
+  if (layer_surface->had_output)
+    {
+      MetaMonitor *monitor;
+
+      if (!layer_surface->output)
+        return NULL;
+
+      monitor = meta_wayland_output_get_monitor (layer_surface->output);
+      return monitor ? meta_monitor_get_logical_monitor (monitor) : NULL;
+    }
+
+  if (layer_surface->monitor_number >= 0)
+    {
+      logical_monitor =
+        meta_monitor_manager_get_logical_monitor_from_number (monitor_manager,
+                                                              layer_surface->monitor_number);
+    }
+
+  if (!logical_monitor)
+    logical_monitor =
+      meta_monitor_manager_get_primary_logical_monitor (monitor_manager);
+
+  return logical_monitor;
+}
+
+/* Client sizes are logical; the stage is in logical units too unless stage
+ * views are unscaled, where it is in physical pixels of an integer scale. */
+static int
+layer_surface_get_scale (MetaWaylandLayerSurface *layer_surface,
+                         MetaLogicalMonitor      *logical_monitor)
+{
+  MetaBackend *backend = layer_shell_get_backend (layer_surface->layer_shell);
+
+  if (meta_backend_is_stage_views_scaled (backend) || !logical_monitor)
+    return 1;
+
+  return MAX (1, (int) meta_logical_monitor_get_scale (logical_monitor));
+}
+
+static gboolean
+meta_wayland_layer_surface_is_on_logical_monitor (MetaWaylandSurfaceRole *surface_role,
+                                                  MetaLogicalMonitor     *logical_monitor)
+{
+  MetaWaylandLayerSurface *layer_surface =
+    META_WAYLAND_LAYER_SURFACE (surface_role);
+
+  /* Only its own output: a client takes wl_output.scale from the outputs
+   * its surface enters. */
+  return layer_surface->mapped &&
+         layer_surface_get_logical_monitor (layer_surface) == logical_monitor;
+}
+
+/* Arrangement (wlr_scene_layer_surface_v1_configure()) */
+
+static uint32_t
+layer_state_get_exclusive_edge (const LayerState *state)
+{
+  if (state->exclusive_edge)
+    return state->exclusive_edge;
+
+  switch (state->anchor)
+    {
+    case ZWLR_LAYER_SURFACE_V1_ANCHOR_TOP:
+    case ZWLR_LAYER_SURFACE_V1_ANCHOR_TOP | ANCHOR_HORIZONTAL:
+      return ZWLR_LAYER_SURFACE_V1_ANCHOR_TOP;
+    case ZWLR_LAYER_SURFACE_V1_ANCHOR_BOTTOM:
+    case ZWLR_LAYER_SURFACE_V1_ANCHOR_BOTTOM | ANCHOR_HORIZONTAL:
+      return ZWLR_LAYER_SURFACE_V1_ANCHOR_BOTTOM;
+    case ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT:
+    case ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT | ANCHOR_VERTICAL:
+      return ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT;
+    case ZWLR_LAYER_SURFACE_V1_ANCHOR_RIGHT:
+    case ZWLR_LAYER_SURFACE_V1_ANCHOR_RIGHT | ANCHOR_VERTICAL:
+      return ZWLR_LAYER_SURFACE_V1_ANCHOR_RIGHT;
+    default:
+      return 0;
+    }
+}
+
+static void
+apply_exclusive_zone (const LayerState *state,
+                      int               scale,
+                      MtkRectangle     *usable)
+{
+  int amount;
+
+  switch (layer_state_get_exclusive_edge (state))
+    {
+    case ZWLR_LAYER_SURFACE_V1_ANCHOR_TOP:
+      amount = (state->exclusive_zone + state->margin.top) * scale;
+      usable->y += amount;
+      usable->height -= amount;
+      break;
+    case ZWLR_LAYER_SURFACE_V1_ANCHOR_BOTTOM:
+      amount = (state->exclusive_zone + state->margin.bottom) * scale;
+      usable->height -= amount;
+      break;
+    case ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT:
+      amount = (state->exclusive_zone + state->margin.left) * scale;
+      usable->x += amount;
+      usable->width -= amount;
+      break;
+    case ZWLR_LAYER_SURFACE_V1_ANCHOR_RIGHT:
+      amount = (state->exclusive_zone + state->margin.right) * scale;
+      usable->width -= amount;
+      break;
+    default:
+      return;
+    }
+
+  usable->width = MAX (usable->width, 0);
+  usable->height = MAX (usable->height, 0);
+}
+
+static MtkRectangle
+compute_box (const LayerState   *state,
+             const MtkRectangle *bounds,
+             int                 scale)
+{
+  MtkRectangle box = {
+    .width = (int) state->width * scale,
+    .height = (int) state->height * scale,
+  };
+
+  if (box.width == 0)
+    box.x = bounds->x;
+  else if ((state->anchor & ANCHOR_HORIZONTAL) == ANCHOR_HORIZONTAL)
+    box.x = bounds->x + (bounds->width / 2) - (box.width / 2);
+  else if (state->anchor & ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT)
+    box.x = bounds->x;
+  else if (state->anchor & ZWLR_LAYER_SURFACE_V1_ANCHOR_RIGHT)
+    box.x = bounds->x + bounds->width - box.width;
+  else
+    box.x = bounds->x + (bounds->width / 2) - (box.width / 2);
+
+  if (box.height == 0)
+    box.y = bounds->y;
+  else if ((state->anchor & ANCHOR_VERTICAL) == ANCHOR_VERTICAL)
+    box.y = bounds->y + (bounds->height / 2) - (box.height / 2);
+  else if (state->anchor & ZWLR_LAYER_SURFACE_V1_ANCHOR_TOP)
+    box.y = bounds->y;
+  else if (state->anchor & ZWLR_LAYER_SURFACE_V1_ANCHOR_BOTTOM)
+    box.y = bounds->y + bounds->height - box.height;
+  else
+    box.y = bounds->y + (bounds->height / 2) - (box.height / 2);
+
+  if (box.width == 0)
+    {
+      box.x += state->margin.left * scale;
+      box.width = bounds->width -
+                  (state->margin.left + state->margin.right) * scale;
+    }
+  else if ((state->anchor & ANCHOR_HORIZONTAL) == ANCHOR_HORIZONTAL)
+    ;
+  else if (state->anchor & ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT)
+    box.x += state->margin.left * scale;
+  else if (state->anchor & ZWLR_LAYER_SURFACE_V1_ANCHOR_RIGHT)
+    box.x -= state->margin.right * scale;
+
+  if (box.height == 0)
+    {
+      box.y += state->margin.top * scale;
+      box.height = bounds->height -
+                   (state->margin.top + state->margin.bottom) * scale;
+    }
+  else if ((state->anchor & ANCHOR_VERTICAL) == ANCHOR_VERTICAL)
+    ;
+  else if (state->anchor & ZWLR_LAYER_SURFACE_V1_ANCHOR_TOP)
+    box.y += state->margin.top * scale;
+  else if (state->anchor & ZWLR_LAYER_SURFACE_V1_ANCHOR_BOTTOM)
+    box.y -= state->margin.bottom * scale;
+
+  return box;
+}
+
+static void
+layer_surface_send_configure (MetaWaylandLayerSurface *layer_surface,
+                              uint32_t                 width,
+                              uint32_t                 height)
+{
+  MetaWaylandSurface *surface = layer_surface_get_surface (layer_surface);
+  struct wl_display *wl_display =
+    meta_wayland_compositor_get_wayland_display (surface->compositor);
+  LayerConfigure *configure;
+
+  configure = g_new0 (LayerConfigure, 1);
+  configure->serial = wl_display_next_serial (wl_display);
+  configure->width = width;
+  configure->height = height;
+  layer_surface->configures = g_list_append (layer_surface->configures,
+                                             configure);
+
+  layer_surface->has_sent_size = TRUE;
+  layer_surface->sent_width = width;
+  layer_surface->sent_height = height;
+
+  meta_topic (META_DEBUG_WAYLAND,
+              "Layer surface %s: configure %u, %ux%u",
+              layer_surface_describe (layer_surface),
+              configure->serial, width, height);
+
+  zwlr_layer_surface_v1_send_configure (layer_surface->resource,
+                                        configure->serial,
+                                        width, height);
+}
+
+static void layer_surface_close (MetaWaylandLayerSurface *layer_surface);
+
+static void
+layer_surface_place (MetaWaylandLayerSurface *layer_surface,
+                     MtkRectangle             box,
+                     int                      scale)
+{
+  MetaWaylandSurface *surface = layer_surface_get_surface (layer_surface);
+  MetaWindow *window;
+  uint32_t width, height;
+
+  if (box.width <= 0 || box.height <= 0)
+    {
+      meta_topic (META_DEBUG_WAYLAND,
+                  "Layer surface %s does not fit its output, closing it",
+                  layer_surface_describe (layer_surface));
+      layer_surface_close (layer_surface);
+      return;
+    }
+
+  layer_surface->box = box;
+
+  width = box.width / scale;
+  height = box.height / scale;
+  if (!layer_surface->has_sent_size ||
+      width != layer_surface->sent_width ||
+      height != layer_surface->sent_height)
+    layer_surface_send_configure (layer_surface, width, height);
+
+  window = layer_surface_get_window (layer_surface);
+  if (window && layer_surface->mapped && meta_wayland_surface_get_buffer (surface))
+    {
+      MtkRectangle rect = {
+        .x = box.x,
+        .y = box.y,
+        .width = meta_wayland_surface_get_width (surface) * scale,
+        .height = meta_wayland_surface_get_height (surface) * scale,
+      };
+
+      meta_window_wayland_set_layer_rect (window, rect);
+    }
+}
+
+static gboolean
+layer_surface_is_arranged (MetaWaylandLayerSurface *layer_surface)
+{
+  return layer_surface->initialized && !layer_surface->closed;
+}
+
+/* Arranges the layer surfaces on @logical_monitor inside @base, the monitor's
+ * work area without them, and returns the part left once their exclusive
+ * zones are taken. Places them when @place is set. */
+static MtkRectangle
+arrange_monitor (MetaWaylandLayerShell *layer_shell,
+                 MetaLogicalMonitor    *logical_monitor,
+                 const MtkRectangle    *base,
+                 gboolean               place)
+{
+  static const uint32_t layer_order[] = {
+    LAYER_OVERLAY, LAYER_TOP, LAYER_BOTTOM, LAYER_BACKGROUND,
+  };
+  MtkRectangle full = logical_monitor->rect;
+  MtkRectangle usable = *base;
+  int pass;
+  size_t i;
+  GList *l;
+
+  for (pass = 0; pass < 2; pass++)
+    {
+      gboolean exclusive_pass = pass == 0;
+
+      for (i = 0; i < G_N_ELEMENTS (layer_order); i++)
+        {
+          for (l = layer_shell->surfaces; l; l = l->next)
+            {
+              MetaWaylandLayerSurface *layer_surface = l->data;
+              const LayerState *state = &layer_surface->current;
+              gboolean exclusive;
+              int scale;
+
+              if (!layer_surface_is_arranged (layer_surface) ||
+                  state->layer != layer_order[i] ||
+                  layer_surface_get_logical_monitor (layer_surface) != logical_monitor)
+                continue;
+
+              exclusive = state->exclusive_zone > 0;
+              if (exclusive != exclusive_pass)
+                continue;
+
+              scale = layer_surface_get_scale (layer_surface, logical_monitor);
+
+              if (place)
+                {
+                  const MtkRectangle *bounds =
+                    state->exclusive_zone == -1 ? &full : &usable;
+
+                  layer_surface_place (layer_surface,
+                                       compute_box (state, bounds, scale),
+                                       scale);
+                }
+
+              if (exclusive && layer_surface->mapped && !layer_surface->closed)
+                apply_exclusive_zone (state, scale, &usable);
+            }
+        }
+    }
+
+  return usable;
+}
+
+static MetaWorkspace *
+layer_shell_get_active_workspace (MetaWaylandLayerShell *layer_shell)
+{
+  MetaDisplay *display = layer_shell_get_display (layer_shell);
+  MetaWorkspaceManager *workspace_manager;
+
+  if (!display)
+    return NULL;
+
+  workspace_manager = meta_display_get_workspace_manager (display);
+  if (!workspace_manager)
+    return NULL;
+
+  return meta_workspace_manager_get_active_workspace (workspace_manager);
+}
+
+static void
+layer_shell_arrange (MetaWaylandLayerShell *layer_shell)
+{
+  MetaBackend *backend = layer_shell_get_backend (layer_shell);
+  MetaMonitorManager *monitor_manager =
+    meta_backend_get_monitor_manager (backend);
+  MetaWorkspace *workspace = layer_shell_get_active_workspace (layer_shell);
+  GList *logical_monitors, *l;
+  GList *closing = NULL;
+
+  /* Surfaces whose output went away, or that have none to go to. */
+  for (l = layer_shell->surfaces; l; l = l->next)
+    {
+      MetaWaylandLayerSurface *layer_surface = l->data;
+
+      if (layer_surface_is_arranged (layer_surface) &&
+          !layer_surface_get_logical_monitor (layer_surface))
+        closing = g_list_prepend (closing, layer_surface);
+    }
+  g_list_free_full (closing, (GDestroyNotify) layer_surface_close);
+
+  logical_monitors =
+    meta_monitor_manager_get_logical_monitors (monitor_manager);
+  for (l = logical_monitors; l; l = l->next)
+    {
+      MetaLogicalMonitor *logical_monitor = l->data;
+      MtkRectangle base = logical_monitor->rect;
+
+      if (workspace)
+        meta_workspace_get_shell_work_area_for_logical_monitor (workspace,
+                                                                logical_monitor,
+                                                                &base);
+
+      arrange_monitor (layer_shell, logical_monitor, &base, TRUE);
+    }
+
+  layer_shell_update_limits (layer_shell);
+}
+
+void
+meta_wayland_layer_shell_apply_exclusive_zones (MetaWaylandCompositor *compositor,
+                                                MetaLogicalMonitor    *logical_monitor,
+                                                MtkRectangle          *work_area)
+{
+  MetaWaylandLayerShell *layer_shell;
+
+  if (!compositor)
+    return;
+
+  layer_shell = layer_shell_from_compositor (compositor);
+  if (!layer_shell || !layer_shell->surfaces)
+    return;
+
+  *work_area = arrange_monitor (layer_shell, logical_monitor, work_area, FALSE);
+}
+
+static void
+layer_shell_invalidate_work_areas (MetaWaylandLayerShell *layer_shell)
+{
+  MetaDisplay *display = layer_shell_get_display (layer_shell);
+  MetaWorkspaceManager *workspace_manager;
+  GList *l;
+
+  if (!display)
+    return;
+
+  workspace_manager = meta_display_get_workspace_manager (display);
+  if (!workspace_manager)
+    return;
+
+  for (l = meta_workspace_manager_get_workspaces (workspace_manager); l; l = l->next)
+    meta_workspace_invalidate_work_area (l->data);
+}
+
+static gboolean
+layer_state_reserves (const LayerState *state)
+{
+  return state->exclusive_zone > 0 && layer_state_get_exclusive_edge (state);
+}
+
+static gboolean
+layer_state_exclusive_changed (const LayerState *a,
+                               const LayerState *b)
+{
+  if (!layer_state_reserves (a) && !layer_state_reserves (b))
+    return FALSE;
+
+  return a->exclusive_zone != b->exclusive_zone ||
+         layer_state_get_exclusive_edge (a) != layer_state_get_exclusive_edge (b) ||
+         a->anchor != b->anchor ||
+         a->layer != b->layer ||
+         a->margin.top != b->margin.top ||
+         a->margin.right != b->margin.right ||
+         a->margin.bottom != b->margin.bottom ||
+         a->margin.left != b->margin.left;
+}
+
+/* Windows */
+
+static MetaWindowType
+window_type_for_layer (uint32_t layer)
+{
+  return layer <= LAYER_BOTTOM ? META_WINDOW_DESKTOP : META_WINDOW_DOCK;
+}
+
+static void
+layer_surface_update_window (MetaWaylandLayerSurface *layer_surface,
+                             MetaWindow              *window)
+{
+  MetaDisplay *display = window->display;
+  gboolean layer_changed;
+
+  layer_changed = window->layer_shell_layer != layer_surface->current.layer;
+
+  window->is_layer_surface = TRUE;
+  window->layer_shell_layer = layer_surface->current.layer;
+  window->input = layer_surface->current.keyboard_interactivity !=
+                  ZWLR_LAYER_SURFACE_V1_KEYBOARD_INTERACTIVITY_NONE;
+
+  meta_window_set_type (window,
+                        window_type_for_layer (layer_surface->current.layer));
+
+  if (layer_changed && display->compositor)
+    {
+      meta_compositor_sync_window_group (display->compositor, window);
+      meta_window_update_layer (window);
+    }
+}
+
+static void
+layer_surface_create_window (MetaWaylandLayerSurface *layer_surface)
+{
+  MetaWaylandSurface *surface = layer_surface_get_surface (layer_surface);
+  MetaWaylandShellSurface *shell_surface =
+    META_WAYLAND_SHELL_SURFACE (layer_surface);
+  MetaDisplay *display = layer_shell_get_display (layer_surface->layer_shell);
+  MetaWindow *window;
+
+  if (meta_wayland_surface_get_window (surface))
+    return;
+
+  window = meta_window_wayland_new (display, surface);
+  meta_wayland_shell_surface_set_window (shell_surface, window);
+  window->type = META_WINDOW_NORMAL;
+  meta_window_set_type (window, window_type_for_layer (layer_surface->current.layer));
+  layer_surface_update_window (layer_surface, window);
+  meta_compositor_sync_window_group (display->compositor, window);
+  meta_window_update_layer (window);
+}
+
+static void
+layer_surface_unmap (MetaWaylandLayerSurface *layer_surface)
+{
+  MetaWaylandShellSurface *shell_surface =
+    META_WAYLAND_SHELL_SURFACE (layer_surface);
+  gboolean reserved;
+
+  if (!layer_surface->mapped)
+    return;
+
+  reserved = layer_state_reserves (&layer_surface->current);
+
+  layer_surface->mapped = FALSE;
+  meta_wayland_shell_surface_destroy_window (shell_surface);
+
+  if (reserved && layer_surface->layer_shell)
+    layer_shell_invalidate_work_areas (layer_surface->layer_shell);
+}
+
+static void
+layer_surface_reset (MetaWaylandLayerSurface *layer_surface)
+{
+  g_clear_list (&layer_surface->configures, g_free);
+  layer_surface->initialized = FALSE;
+  layer_surface->acked = FALSE;
+  layer_surface->has_sent_size = FALSE;
+}
+
+static void
+layer_surface_close (MetaWaylandLayerSurface *layer_surface)
+{
+  if (layer_surface->closed)
+    return;
+
+  meta_topic (META_DEBUG_WAYLAND, "Layer surface %s closed",
+              layer_surface_describe (layer_surface));
+
+  layer_surface->closed = TRUE;
+  layer_surface_unmap (layer_surface);
+  layer_surface_reset (layer_surface);
+
+  if (layer_surface->resource)
+    zwlr_layer_surface_v1_send_closed (layer_surface->resource);
+
+  if (layer_surface->layer_shell)
+    layer_shell_update_state (layer_surface->layer_shell);
+}
+
+/* Keyboard */
+
+static gboolean
+layer_surface_holds_exclusive_keyboard (MetaWaylandLayerSurface *layer_surface)
+{
+  return layer_surface->mapped &&
+         !layer_surface->closed &&
+         layer_surface->current.layer >= LAYER_TOP &&
+         layer_surface->current.keyboard_interactivity ==
+         ZWLR_LAYER_SURFACE_V1_KEYBOARD_INTERACTIVITY_EXCLUSIVE &&
+         layer_surface_get_window (layer_surface) != NULL;
+}
+
+static MetaWaylandLayerSurface *
+layer_shell_get_exclusive_surface (MetaWaylandLayerShell *layer_shell)
+{
+  MetaWaylandLayerSurface *best = NULL;
+  GList *l;
+
+  if (layer_shell->suspended)
+    return NULL;
+
+  for (l = layer_shell->surfaces; l; l = l->next)
+    {
+      MetaWaylandLayerSurface *layer_surface = l->data;
+
+      if (!layer_surface_holds_exclusive_keyboard (layer_surface))
+        continue;
+
+      /* The highest layer, then the newest. */
+      if (!best || layer_surface->current.layer >= best->current.layer)
+        best = layer_surface;
+    }
+
+  return best;
+}
+
+static gboolean
+window_belongs_to (MetaWindow *window,
+                   MetaWindow *owner)
+{
+  return window == owner ||
+         meta_window_find_root_ancestor (window) == owner;
+}
+
+static void
+layer_shell_sync_keyboard_focus (MetaWaylandLayerShell *layer_shell)
+{
+  MetaDisplay *display = layer_shell_get_display (layer_shell);
+  MetaWaylandLayerSurface *exclusive;
+  MetaWindow *focus_window;
+  MetaWindow *window;
+
+  if (!display || layer_shell->syncing_focus)
+    return;
+
+  exclusive = layer_shell_get_exclusive_surface (layer_shell);
+  if (!exclusive)
+    return;
+
+  window = layer_surface_get_window (exclusive);
+  focus_window = meta_display_get_focus_window (display);
+  if (focus_window && window_belongs_to (focus_window, window))
+    return;
+
+  meta_topic (META_DEBUG_FOCUS,
+              "Layer surface %s keeps the keyboard (exclusive)",
+              layer_surface_describe (exclusive));
+
+  layer_shell->syncing_focus = TRUE;
+  meta_window_focus (window, meta_display_get_current_time_roundtrip (display));
+  layer_shell->syncing_focus = FALSE;
+}
+
+static void
+layer_surface_focus_on_map (MetaWaylandLayerSurface *layer_surface)
+{
+  MetaWaylandLayerShell *layer_shell = layer_surface->layer_shell;
+  MetaDisplay *display = layer_shell_get_display (layer_shell);
+  MetaWindow *window = layer_surface_get_window (layer_surface);
+
+  if (!window || layer_shell->suspended)
+    return;
+
+  /* Exclusive keyboard (KEYBOARD) takes it when the surface maps; on_demand
+   * only after a click on the surface. */
+  if (layer_surface->current.keyboard_interactivity !=
+      ZWLR_LAYER_SURFACE_V1_KEYBOARD_INTERACTIVITY_EXCLUSIVE ||
+      layer_surface->current.layer < LAYER_TOP)
+    return;
+
+  meta_window_focus (window, meta_display_get_current_time_roundtrip (display));
+}
+
+static void
+layer_surface_drop_focus (MetaWaylandLayerSurface *layer_surface)
+{
+  MetaDisplay *display = layer_shell_get_display (layer_surface->layer_shell);
+  MetaWindow *window = layer_surface_get_window (layer_surface);
+  MetaWorkspace *workspace;
+
+  if (!window || meta_display_get_focus_window (display) != window)
+    return;
+
+  workspace = layer_shell_get_active_workspace (layer_surface->layer_shell);
+  if (workspace)
+    {
+      meta_workspace_focus_default_window (workspace, window,
+                                           meta_display_get_current_time_roundtrip (display));
+    }
+}
+
+static void
+on_focus_window_changed (MetaDisplay           *display,
+                         GParamSpec            *pspec,
+                         MetaWaylandLayerShell *layer_shell)
+{
+  layer_shell_sync_keyboard_focus (layer_shell);
+  layer_shell_update_limits (layer_shell);
+}
+
+/* Capabilities */
+
+typedef struct
+{
+  MetaLayerShellCapabilities granted;
+  MetaLayerShellCapabilities refused;
+} Grants;
+
+static const char *
+capability_name (MetaLayerShellCapabilities capability)
+{
+  switch (capability)
+    {
+    case META_LAYER_SHELL_CAPABILITY_BACKGROUND:
+      return "background";
+    case META_LAYER_SHELL_CAPABILITY_PANEL:
+      return "panel";
+    case META_LAYER_SHELL_CAPABILITY_OVERLAY:
+      return "overlay";
+    case META_LAYER_SHELL_CAPABILITY_KEYBOARD:
+      return "keyboard";
+    default:
+      return "none";
+    }
+}
+
+static const char *
+layer_surface_app (MetaWaylandLayerSurface *layer_surface)
+{
+  return layer_surface->app_id ? layer_surface->app_id : "(unknown app)";
+}
+
+/* TRUE the first time @what is seen for @app_id this session. */
+static gboolean
+report_once (MetaWaylandLayerShell *layer_shell,
+             const char            *app_id,
+             const char            *what)
+{
+  char *key = g_strdup_printf ("%s\x1f%s", app_id ? app_id : "", what);
+
+  if (g_hash_table_contains (layer_shell->reported, key))
+    {
+      g_free (key);
+      return FALSE;
+    }
+
+  g_hash_table_add (layer_shell->reported, key);
+  return TRUE;
+}
+
+static MetaLayerShellCapabilities
+layer_shell_get_capabilities (MetaWaylandLayerShell *layer_shell,
+                              gboolean               is_shell,
+                              gboolean               sandboxed,
+                              const char            *app_id)
+{
+  MetaLayerShellCapabilities capabilities;
+  Grants *grants;
+
+  if (is_shell)
+    return CAPS_ALL;
+
+  if (sandboxed && !app_id)
+    return 0;
+
+  capabilities = sandboxed ? 0 : CAPS_HOST_DEFAULT;
+
+  grants = app_id ? g_hash_table_lookup (layer_shell->grants, app_id) : NULL;
+  if (grants)
+    capabilities = (capabilities | grants->granted) & ~grants->refused;
+
+  return capabilities & CAPS_ALL;
+}
+
+static MetaLayerShellCapabilities
+layer_surface_get_capabilities (MetaWaylandLayerSurface *layer_surface)
+{
+  return layer_shell_get_capabilities (layer_surface->layer_shell,
+                                       layer_surface->is_shell,
+                                       layer_surface->sandboxed,
+                                       layer_surface->app_id);
+}
+
+static gboolean
+layer_surface_is_stopped (MetaWaylandLayerSurface *layer_surface)
+{
+  return !layer_surface->is_shell && layer_surface->app_id &&
+         g_hash_table_contains (layer_surface->layer_shell->stopped,
+                                layer_surface->app_id);
+}
+
+/* What showing @state takes. */
+static MetaLayerShellCapabilities
+layer_state_needs (const LayerState *state)
+{
+  MetaLayerShellCapabilities needs;
+
+  switch (state->layer)
+    {
+    case LAYER_BACKGROUND:
+      needs = META_LAYER_SHELL_CAPABILITY_BACKGROUND;
+      break;
+    case LAYER_OVERLAY:
+      needs = META_LAYER_SHELL_CAPABILITY_OVERLAY;
+      break;
+    default:
+      needs = META_LAYER_SHELL_CAPABILITY_PANEL;
+      break;
+    }
+
+  if (state->keyboard_interactivity ==
+      ZWLR_LAYER_SURFACE_V1_KEYBOARD_INTERACTIVITY_EXCLUSIVE)
+    needs |= META_LAYER_SHELL_CAPABILITY_KEYBOARD;
+
+  return needs;
+}
+
+/*
+ * Clamps @requested to what @capabilities allow, into @out; @missing gets
+ * what was asked for and not granted. Returns FALSE when no layer is left.
+ */
+static gboolean
+clamp_state (const LayerState           *requested,
+             MetaLayerShellCapabilities  capabilities,
+             LayerState                 *out,
+             MetaLayerShellCapabilities *missing)
+{
+  *out = *requested;
+  *missing = 0;
+
+  switch (requested->layer)
+    {
+    case LAYER_OVERLAY:
+      if (capabilities & META_LAYER_SHELL_CAPABILITY_OVERLAY)
+        break;
+      *missing |= META_LAYER_SHELL_CAPABILITY_OVERLAY;
+      if (!(capabilities & META_LAYER_SHELL_CAPABILITY_PANEL))
+        return FALSE;
+      out->layer = LAYER_TOP;
+      break;
+    case LAYER_TOP:
+    case LAYER_BOTTOM:
+      if (capabilities & META_LAYER_SHELL_CAPABILITY_PANEL)
+        break;
+      *missing |= META_LAYER_SHELL_CAPABILITY_PANEL;
+      return FALSE;
+    case LAYER_BACKGROUND:
+      if (capabilities & META_LAYER_SHELL_CAPABILITY_BACKGROUND)
+        break;
+      *missing |= META_LAYER_SHELL_CAPABILITY_BACKGROUND;
+      if (!(capabilities & META_LAYER_SHELL_CAPABILITY_PANEL))
+        return FALSE;
+      out->layer = LAYER_BOTTOM;
+      break;
+    }
+
+  /* Only a panel reserves space. */
+  if (out->layer != LAYER_TOP && out->layer != LAYER_BOTTOM &&
+      out->exclusive_zone > 0)
+    out->exclusive_zone = 0;
+
+  if (out->layer == LAYER_BACKGROUND)
+    {
+      out->keyboard_interactivity =
+        ZWLR_LAYER_SURFACE_V1_KEYBOARD_INTERACTIVITY_NONE;
+    }
+  else if (out->keyboard_interactivity ==
+           ZWLR_LAYER_SURFACE_V1_KEYBOARD_INTERACTIVITY_EXCLUSIVE &&
+           !(capabilities & META_LAYER_SHELL_CAPABILITY_KEYBOARD))
+    {
+      *missing |= META_LAYER_SHELL_CAPABILITY_KEYBOARD;
+      out->keyboard_interactivity =
+        ZWLR_LAYER_SURFACE_V1_KEYBOARD_INTERACTIVITY_ON_DEMAND;
+    }
+
+  return TRUE;
+}
+
+static void
+layer_surface_report_clamp (MetaWaylandLayerSurface    *layer_surface,
+                            MetaLayerShellCapabilities  missing,
+                            gboolean                    refused)
+{
+  MetaWaylandLayerShell *layer_shell = layer_surface->layer_shell;
+  MetaLayerShellCapabilities capability;
+
+  for (capability = 1; capability & CAPS_ALL; capability <<= 1)
+    {
+      g_autofree char *what = NULL;
+
+      if (!(missing & capability))
+        continue;
+
+      what = g_strdup_printf ("clamp-%s-%d", capability_name (capability),
+                              refused);
+      if (report_once (layer_shell, layer_surface->app_id, what))
+        {
+          g_message ("Layer surface \"%s\" of %s has no %s permission: %s",
+                     layer_surface_describe (layer_surface),
+                     layer_surface_app (layer_surface),
+                     capability_name (capability),
+                     refused ? "refused" :
+                     capability == META_LAYER_SHELL_CAPABILITY_OVERLAY ?
+                     "placed on the top layer" :
+                     capability == META_LAYER_SHELL_CAPABILITY_BACKGROUND ?
+                     "placed on the bottom layer" :
+                     "keyboard on demand");
+        }
+
+      g_clear_pointer (&what, g_free);
+      what = g_strdup_printf ("offer-%s", capability_name (capability));
+      if (layer_surface->app_id &&
+          report_once (layer_shell, layer_surface->app_id, what))
+        {
+          g_signal_emit_by_name (layer_shell->compositor,
+                                 "layer-shell-clamped",
+                                 layer_surface->app_id, (guint) capability);
+        }
+    }
+}
+
+static void
+layer_surface_report_used (MetaWaylandLayerSurface *layer_surface)
+{
+  MetaWaylandLayerShell *layer_shell = layer_surface->layer_shell;
+  MetaLayerShellCapabilities used = layer_state_needs (&layer_surface->current);
+  MetaLayerShellCapabilities capability;
+
+  if (layer_surface->is_shell || !layer_surface->app_id)
+    return;
+
+  for (capability = 1; capability & CAPS_ALL; capability <<= 1)
+    {
+      g_autofree char *what = NULL;
+
+      if (!(used & capability))
+        continue;
+
+      what = g_strdup_printf ("used-%s", capability_name (capability));
+      if (report_once (layer_shell, layer_surface->app_id, what))
+        {
+          g_signal_emit_by_name (layer_shell->compositor, "layer-shell-used",
+                                 layer_surface->app_id, (guint) capability);
+        }
+    }
+}
+
+/*
+ * Host clients see the global. A sandboxed application sees it unless it has
+ * no application ID to grant it by or every capability was refused, as in
+ * sway, niri and COSMIC; otherwise its surfaces are clamped to its grants
+ * (nothing, at first), and the Shell is told, so it can offer them.
+ */
+static MetaWaylandAccess
+filter_layer_shell_global (const struct wl_client *client,
+                           const struct wl_global *global,
+                           gpointer                user_data)
+{
+  MetaWaylandLayerShell *layer_shell = user_data;
+  const MetaWaylandClientIdentity *identity =
+    meta_wayland_client_get_identity (client);
+  Grants *grants;
+
+  if (!identity->sandboxed)
+    return META_WAYLAND_ACCESS_ALLOWED;
+
+  if (!identity->app_id)
+    return META_WAYLAND_ACCESS_DENIED;
+
+  grants = g_hash_table_lookup (layer_shell->grants, identity->app_id);
+  if (grants && (grants->refused & CAPS_ALL) == CAPS_ALL)
+    return META_WAYLAND_ACCESS_DENIED;
+
+  return META_WAYLAND_ACCESS_ALLOWED;
+}
+
+static void
+close_surfaces_needing (MetaWaylandLayerShell      *layer_shell,
+                        const char                 *app_id,
+                        MetaLayerShellCapabilities  capabilities)
+{
+  GList *closing = NULL;
+  GList *l;
+
+  for (l = layer_shell->surfaces; l; l = l->next)
+    {
+      MetaWaylandLayerSurface *layer_surface = l->data;
+
+      if (layer_surface->is_shell ||
+          g_strcmp0 (layer_surface->app_id, app_id) != 0 ||
+          !layer_surface->initialized)
+        continue;
+
+      if (layer_state_needs (&layer_surface->current) & capabilities)
+        closing = g_list_prepend (closing, layer_surface);
+    }
+  g_list_free_full (closing, (GDestroyNotify) layer_surface_close);
+}
+
+/**
+ * meta_wayland_compositor_set_layer_shell_grants:
+ * @compositor: a #MetaWaylandCompositor
+ * @app_id: an application ID (a Flatpak ID, a desktop-file ID without
+ *   ".desktop", or an executable's name)
+ * @granted: capabilities given beyond the defaults
+ * @refused: capabilities taken away, defaults included
+ *
+ * Sets what @app_id may do with the layer shell. Host applications have
+ * BACKGROUND and PANEL unless refused, sandboxed ones nothing unless
+ * granted. The application's surfaces are clamped again at once: one held
+ * back for lack of a capability now given is shown without the application
+ * doing anything, one using a capability taken away is clamped or hidden.
+ */
+void
+meta_wayland_compositor_set_layer_shell_grants (MetaWaylandCompositor      *compositor,
+                                                const char                 *app_id,
+                                                MetaLayerShellCapabilities  granted,
+                                                MetaLayerShellCapabilities  refused)
+{
+  MetaWaylandLayerShell *layer_shell;
+  Grants *grants;
+  GList *l;
+
+  g_return_if_fail (META_IS_WAYLAND_COMPOSITOR (compositor));
+  g_return_if_fail (app_id != NULL);
+
+  layer_shell = layer_shell_from_compositor (compositor);
+  if (!layer_shell)
+    return;
+
+  grants = g_new0 (Grants, 1);
+  grants->granted = granted & CAPS_ALL;
+  grants->refused = refused & CAPS_ALL;
+  g_hash_table_insert (layer_shell->grants, g_strdup (app_id), grants);
+
+  for (l = layer_shell->surfaces; l; l = l->next)
+    {
+      MetaWaylandLayerSurface *layer_surface = l->data;
+
+      if (g_strcmp0 (layer_surface->app_id, app_id) == 0)
+        layer_surface_reevaluate (layer_surface);
+    }
+
+  layer_shell_arrange (layer_shell);
+  layer_shell_sync_keyboard_focus (layer_shell);
+}
+
+/**
+ * meta_wayland_compositor_close_layer_surfaces:
+ * @compositor: a #MetaWaylandCompositor
+ * @app_id: an application ID
+ * @capabilities: which surfaces: those using any of these
+ *
+ * Closes @app_id's layer surfaces that use @capabilities (the Shell's
+ * "stop displaying over other apps").
+ */
+void
+meta_wayland_compositor_close_layer_surfaces (MetaWaylandCompositor      *compositor,
+                                              const char                 *app_id,
+                                              MetaLayerShellCapabilities  capabilities)
+{
+  MetaWaylandLayerShell *layer_shell;
+
+  g_return_if_fail (META_IS_WAYLAND_COMPOSITOR (compositor));
+
+  layer_shell = layer_shell_from_compositor (compositor);
+  if (layer_shell && app_id)
+    close_surfaces_needing (layer_shell, app_id, capabilities);
+}
+
+/**
+ * meta_wayland_compositor_get_layer_shell_faded_windows:
+ * @compositor: a #MetaWaylandCompositor
+ *
+ * The windows of layer surfaces faded by the coverage limit, for the
+ * Shell's name tag ("layer-shell-surfaces-changed" says when this changes).
+ *
+ * Returns: (transfer container) (element-type Meta.Window): the windows
+ */
+GList *
+meta_wayland_compositor_get_layer_shell_faded_windows (MetaWaylandCompositor *compositor)
+{
+  MetaWaylandLayerShell *layer_shell;
+  GList *windows = NULL;
+  GList *l;
+
+  g_return_val_if_fail (META_IS_WAYLAND_COMPOSITOR (compositor), NULL);
+
+  layer_shell = layer_shell_from_compositor (compositor);
+  for (l = layer_shell ? layer_shell->surfaces : NULL; l; l = l->next)
+    {
+      MetaWaylandLayerSurface *layer_surface = l->data;
+      MetaWindow *window = layer_surface_get_window (layer_surface);
+
+      if (window && layer_surface->mapped && layer_surface->dimmed &&
+          !layer_shell->suspended)
+        windows = g_list_prepend (windows, window);
+    }
+
+  return g_list_reverse (windows);
+}
+
+/**
+ * meta_wayland_compositor_get_layer_shell_app_id:
+ * @compositor: a #MetaWaylandCompositor
+ * @window: a #MetaWindow
+ *
+ * Returns: (nullable): the application ID of the layer surface behind
+ *   @window, if it is one
+ */
+const char *
+meta_wayland_compositor_get_layer_shell_app_id (MetaWaylandCompositor *compositor,
+                                                MetaWindow            *window)
+{
+  MetaWaylandLayerShell *layer_shell;
+  GList *l;
+
+  g_return_val_if_fail (META_IS_WAYLAND_COMPOSITOR (compositor), NULL);
+
+  layer_shell = layer_shell_from_compositor (compositor);
+  for (l = layer_shell ? layer_shell->surfaces : NULL; l; l = l->next)
+    {
+      MetaWaylandLayerSurface *layer_surface = l->data;
+
+      if (layer_surface_get_window (layer_surface) == window)
+        return layer_surface->app_id;
+    }
+
+  return NULL;
+}
+
+/**
+ * meta_wayland_compositor_stop_layer_overlays:
+ * @compositor: a #MetaWaylandCompositor
+ * @app_id: an application ID
+ *
+ * Unmaps @app_id's overlay surfaces (they are closed) and refuses its new
+ * ones until the session ends, without changing its grants.
+ */
+void
+meta_wayland_compositor_stop_layer_overlays (MetaWaylandCompositor *compositor,
+                                             const char            *app_id)
+{
+  MetaWaylandLayerShell *layer_shell;
+
+  g_return_if_fail (META_IS_WAYLAND_COMPOSITOR (compositor));
+  g_return_if_fail (app_id != NULL);
+
+  layer_shell = layer_shell_from_compositor (compositor);
+  if (!layer_shell)
+    return;
+
+  g_message ("Layer surfaces: overlays of %s stopped for this session", app_id);
+  g_hash_table_add (layer_shell->stopped, g_strdup (app_id));
+  close_surfaces_needing (layer_shell, app_id,
+                          META_LAYER_SHELL_CAPABILITY_OVERLAY);
+}
