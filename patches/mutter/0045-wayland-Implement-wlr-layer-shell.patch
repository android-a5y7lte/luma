+
+static void
+layer_surface_set_keyboard_interactivity (struct wl_client   *client,
+                                          struct wl_resource *resource,
+                                          uint32_t            keyboard_interactivity)
+{
+  MetaWaylandLayerSurface *layer_surface = wl_resource_get_user_data (resource);
+  uint32_t highest =
+    wl_resource_get_version (resource) >= 4
+      ? ZWLR_LAYER_SURFACE_V1_KEYBOARD_INTERACTIVITY_ON_DEMAND
+      : ZWLR_LAYER_SURFACE_V1_KEYBOARD_INTERACTIVITY_EXCLUSIVE;
+
+  if (keyboard_interactivity > highest)
+    {
+      wl_resource_post_error (resource,
+                              ZWLR_LAYER_SURFACE_V1_ERROR_INVALID_KEYBOARD_INTERACTIVITY,
+                              "invalid keyboard interactivity %u",
+                              keyboard_interactivity);
+      return;
+    }
+
+  if (!layer_surface)
+    return;
+
+  layer_surface->pending.keyboard_interactivity = keyboard_interactivity;
+}
+
+static void
+layer_surface_get_popup (struct wl_client   *client,
+                         struct wl_resource *resource,
+                         struct wl_resource *popup_resource)
+{
+  MetaWaylandLayerSurface *layer_surface = wl_resource_get_user_data (resource);
+  MetaWaylandXdgPopup *xdg_popup = wl_resource_get_user_data (popup_resource);
+
+  if (!layer_surface || layer_surface->closed)
+    {
+      meta_wayland_xdg_popup_dismiss_parentless (xdg_popup);
+      return;
+    }
+
+  if (!meta_wayland_xdg_popup_set_parent (xdg_popup,
+                                          layer_surface_get_surface (layer_surface)))
+    {
+      wl_resource_post_error (resource,
+                              ZWLR_LAYER_SURFACE_V1_ERROR_INVALID_SURFACE_STATE,
+                              "xdg_popup@%u already has a parent",
+                              wl_resource_get_id (popup_resource));
+    }
+}
+
+static void
+layer_surface_ack_configure (struct wl_client   *client,
+                             struct wl_resource *resource,
+                             uint32_t            serial)
+{
+  MetaWaylandLayerSurface *layer_surface = wl_resource_get_user_data (resource);
+  LayerConfigure *found = NULL;
+  GList *l;
+
+  if (!layer_surface || layer_surface->closed)
+    return;
+
+  for (l = layer_surface->configures; l; l = l->next)
+    {
+      LayerConfigure *configure = l->data;
+
+      if (configure->serial == serial)
+        {
+          found = configure;
+          break;
+        }
+    }
+
+  if (!found)
+    {
+      wl_resource_post_error (resource,
+                              ZWLR_LAYER_SURFACE_V1_ERROR_INVALID_SURFACE_STATE,
+                              "wrong configure serial %u", serial);
+      return;
+    }
+
+  /* Drop it and every older one. */
+  while (layer_surface->configures)
+    {
+      LayerConfigure *configure = layer_surface->configures->data;
+
+      layer_surface->configures =
+        g_list_delete_link (layer_surface->configures,
+                            layer_surface->configures);
+      g_free (configure);
+
+      if (configure == found)
+        break;
+    }
+
+  layer_surface->acked = TRUE;
+}
+
+static void
+layer_surface_destroy (struct wl_client   *client,
+                       struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static void
+layer_surface_set_layer (struct wl_client   *client,
+                         struct wl_resource *resource,
+                         uint32_t            layer)
+{
+  MetaWaylandLayerSurface *layer_surface = wl_resource_get_user_data (resource);
+
+  if (layer > LAYER_OVERLAY)
+    {
+      wl_resource_post_error (resource,
+                              ZWLR_LAYER_SHELL_V1_ERROR_INVALID_LAYER,
+                              "invalid layer %u", layer);
+      return;
+    }
+
+  if (!layer_surface)
+    return;
+
+  layer_surface->pending.layer = layer;
+}
+
+static void
+layer_surface_set_exclusive_edge (struct wl_client   *client,
+                                  struct wl_resource *resource,
+                                  uint32_t            edge)
+{
+  MetaWaylandLayerSurface *layer_surface = wl_resource_get_user_data (resource);
+
+  /* At most one edge; whether the surface is anchored to it is checked when
+   * the state is committed. */
+  if (edge & ~ANCHOR_ALL || (edge & (edge - 1)) != 0)
+    {
+      wl_resource_post_error (resource,
+                              ZWLR_LAYER_SURFACE_V1_ERROR_INVALID_EXCLUSIVE_EDGE,
+                              "invalid exclusive edge %u", edge);
+      return;
+    }
+
+  if (!layer_surface)
+    return;
+
+  layer_surface->pending.exclusive_edge = edge;
+}
+
+static const struct zwlr_layer_surface_v1_interface layer_surface_interface = {
+  .set_size = layer_surface_set_size,
+  .set_anchor = layer_surface_set_anchor,
+  .set_exclusive_zone = layer_surface_set_exclusive_zone,
+  .set_margin = layer_surface_set_margin,
+  .set_keyboard_interactivity = layer_surface_set_keyboard_interactivity,
+  .get_popup = layer_surface_get_popup,
+  .ack_configure = layer_surface_ack_configure,
+  .destroy = layer_surface_destroy,
+  .set_layer = layer_surface_set_layer,
+  .set_exclusive_edge = layer_surface_set_exclusive_edge,
+};
+
+static void
+layer_surface_detach (MetaWaylandLayerSurface *layer_surface)
+{
+  MetaWaylandLayerShell *layer_shell = layer_surface->layer_shell;
+
+  if (!layer_shell)
+    return;
+
+  layer_shell->surfaces = g_list_remove (layer_shell->surfaces, layer_surface);
+  layer_surface->layer_shell = NULL;
+}
+
+static void
+layer_surface_resource_destroyed (struct wl_resource *resource)
+{
+  MetaWaylandLayerSurface *layer_surface = wl_resource_get_user_data (resource);
+  MetaWaylandLayerShell *layer_shell;
+  gboolean reserved;
+
+  if (!layer_surface)
+    return;
+
+  layer_shell = layer_surface->layer_shell;
+  reserved = layer_surface->mapped &&
+             layer_state_reserves (&layer_surface->current);
+
+  layer_surface->mapped = FALSE;
+  meta_wayland_shell_surface_destroy_window (META_WAYLAND_SHELL_SURFACE (layer_surface));
+  layer_surface_reset (layer_surface);
+  layer_surface->resource = NULL;
+  layer_surface_detach (layer_surface);
+
+  if (layer_shell)
+    {
+      if (reserved)
+        layer_shell_invalidate_work_areas (layer_shell);
+      layer_shell_arrange (layer_shell);
+    }
+}
+
+/* Surface role */
+
+static void
+meta_wayland_layer_surface_commit_state (MetaWaylandSurfaceRole  *surface_role,
+                                         MetaWaylandTransaction  *transaction,
+                                         MetaWaylandSurfaceState *pending)
+{
+  MetaWaylandLayerSurface *layer_surface =
+    META_WAYLAND_LAYER_SURFACE (surface_role);
+  MetaWaylandSurface *surface = meta_wayland_surface_role_get_surface (surface_role);
+  const LayerState *state = &layer_surface->pending;
+  MetaWaylandSurfaceRoleClass *surface_role_class =
+    META_WAYLAND_SURFACE_ROLE_CLASS (meta_wayland_layer_surface_parent_class);
+  gboolean attaches_buffer;
+
+  if (surface_role_class->commit_state)
+    surface_role_class->commit_state (surface_role, transaction, pending);
+
+  if (!layer_surface->resource || layer_surface->closed)
+    return;
+
+  if (state->width == 0 &&
+      (state->anchor & ANCHOR_HORIZONTAL) != ANCHOR_HORIZONTAL)
+    {
+      wl_resource_post_error (layer_surface->resource,
+                              ZWLR_LAYER_SURFACE_V1_ERROR_INVALID_SIZE,
+                              "width 0 needs anchors to the left and right edges");
+      return;
+    }
+
+  if (state->height == 0 &&
+      (state->anchor & ANCHOR_VERTICAL) != ANCHOR_VERTICAL)
+    {
+      wl_resource_post_error (layer_surface->resource,
+                              ZWLR_LAYER_SURFACE_V1_ERROR_INVALID_SIZE,
+                              "height 0 needs anchors to the top and bottom edges");
+      return;
+    }
+
+  if (state->exclusive_edge && !(state->anchor & state->exclusive_edge))
+    {
+      wl_resource_post_error (layer_surface->resource,
+                              ZWLR_LAYER_SURFACE_V1_ERROR_INVALID_EXCLUSIVE_EDGE,
+                              "exclusive edge %u is not an anchor",
+                              state->exclusive_edge);
+      return;
+    }
+
+  attaches_buffer = pending->newly_attached && pending->buffer;
+  if (attaches_buffer && !layer_surface->acked)
+    {
+      wl_resource_post_error (layer_surface->resource,
+                              ZWLR_LAYER_SURFACE_V1_ERROR_INVALID_SURFACE_STATE,
+                              "wl_surface@%u has a buffer before its first "
+                              "configure was acknowledged",
+                              wl_resource_get_id (surface->resource));
+      return;
+    }
+
+  layer_surface->committed = layer_surface->pending;
+}
+
+static void
+layer_surface_map (MetaWaylandLayerSurface *layer_surface)
+{
+  MetaWaylandLayerShell *layer_shell = layer_surface->layer_shell;
+
+  layer_surface_create_window (layer_surface);
+  layer_surface->mapped = TRUE;
+  layer_surface->mapped_since = g_get_real_time ();
+
+  meta_topic (META_DEBUG_WAYLAND, "Layer surface %s mapped on layer %u",
+              layer_surface_describe (layer_surface),
+              layer_surface->current.layer);
+
+  layer_surface_report_used (layer_surface);
+  (void) layer_shell;
+}
+
+/* Clamps the committed state to the grants into current. Returns FALSE, with
+ * the surface held, when it may not be shown. */
+static gboolean
+layer_surface_clamp (MetaWaylandLayerSurface *layer_surface,
+                     gboolean                 report)
+{
+  MetaLayerShellCapabilities capabilities =
+    layer_surface_get_capabilities (layer_surface);
+  MetaLayerShellCapabilities missing = 0;
+  LayerState clamped;
+  gboolean allowed;
+
+  if (layer_surface_is_stopped (layer_surface) &&
+      layer_surface->committed.layer == LAYER_OVERLAY)
+    {
+      /* Stopped this session: not clamped onto another layer either. */
+      allowed = FALSE;
+    }
+  else
+    {
+      allowed = clamp_state (&layer_surface->committed, capabilities,
+                             &clamped, &missing);
+    }
+
+  if (report && missing)
+    layer_surface_report_clamp (layer_surface, missing, !allowed);
+
+  layer_surface->held = !allowed;
+  layer_surface->current = allowed ? clamped : layer_surface->committed;
+  return allowed;
+}
+
+/* After the grants changed: show a held surface they now allow, hide one
+ * they no longer do, move one to the layer it is now allowed. The caller
+ * arranges. */
+static void
+layer_surface_reevaluate (MetaWaylandLayerSurface *layer_surface)
+{
+  MetaWaylandSurface *surface = layer_surface_get_surface (layer_surface);
+  LayerState old_state = layer_surface->current;
+  MetaWindow *window;
+
+  if (!layer_surface->initialized || layer_surface->closed ||
+      !layer_surface->resource)
+    return;
+
+  if (!layer_surface_clamp (layer_surface, FALSE))
+    {
+      layer_surface_unmap (layer_surface);
+      return;
+    }
+
+  if (!layer_surface->mapped)
+    {
+      if (!meta_wayland_surface_get_buffer (surface))
+        return;
+
+      meta_topic (META_DEBUG_WAYLAND, "Layer surface %s of %s allowed: mapped",
+                  layer_surface_describe (layer_surface),
+                  layer_surface_app (layer_surface));
+      layer_surface_map (layer_surface);
+      window = layer_surface_get_window (layer_surface);
+      if (window)
+        meta_window_queue (window, META_QUEUE_CALC_SHOWING);
+      if (layer_state_reserves (&layer_surface->current))
+        layer_shell_invalidate_work_areas (layer_surface->layer_shell);
+      layer_surface_focus_on_map (layer_surface);
+      return;
+    }
+
+  window = layer_surface_get_window (layer_surface);
+  if (!window)
+    return;
+
+  if (old_state.layer != layer_surface->current.layer ||
+      old_state.keyboard_interactivity !=
+      layer_surface->current.keyboard_interactivity)
+    {
+      layer_surface_update_window (layer_surface, window);
+      layer_surface_report_used (layer_surface);
+      if (layer_surface->current.keyboard_interactivity ==
+          ZWLR_LAYER_SURFACE_V1_KEYBOARD_INTERACTIVITY_NONE)
+        layer_surface_drop_focus (layer_surface);
+    }
+
+  if (layer_state_exclusive_changed (&old_state, &layer_surface->current))
+    layer_shell_invalidate_work_areas (layer_surface->layer_shell);
+}
+
+static void
+meta_wayland_layer_surface_apply_state (MetaWaylandSurfaceRole  *surface_role,
+                                        MetaWaylandSurfaceState *pending)
+{
+  MetaWaylandLayerSurface *layer_surface =
+    META_WAYLAND_LAYER_SURFACE (surface_role);
+  MetaWaylandActorSurface *actor_surface =
+    META_WAYLAND_ACTOR_SURFACE (surface_role);
+  MetaWaylandSurface *surface = meta_wayland_surface_role_get_surface (surface_role);
+  MetaWaylandSurfaceRoleClass *surface_role_class =
+    META_WAYLAND_SURFACE_ROLE_CLASS (meta_wayland_layer_surface_parent_class);
+  MetaWaylandLayerShell *layer_shell = layer_surface->layer_shell;
+  LayerState old_state;
+  gboolean has_buffer;
+  gboolean was_mapped;
+  gboolean work_areas_changed = FALSE;
+  gboolean focus_changed = FALSE;
+  MetaWindow *window;
+
+  if (layer_surface->closed || !layer_surface->resource || !layer_shell)
+    {
+      meta_wayland_actor_surface_queue_frame_callbacks (actor_surface, pending);
+      return;
+    }
+
+  old_state = layer_surface->current;
+  if (!layer_surface_clamp (layer_surface, TRUE) &&
+      layer_surface_is_stopped (layer_surface) &&
+      layer_surface->committed.layer == LAYER_OVERLAY)
+    {
+      meta_wayland_actor_surface_queue_frame_callbacks (actor_surface, pending);
+      layer_surface_close (layer_surface);
+      return;
+    }
+  has_buffer = surface->buffer != NULL;
+  was_mapped = layer_surface->mapped;
+
+  /* A window, and so an actor to draw into, before the buffer is applied. */
+  if (has_buffer && !was_mapped && layer_surface->initialized &&
+      !layer_surface->held)
+    {
+      layer_surface_map (layer_surface);
+      work_areas_changed = layer_state_reserves (&layer_surface->current);
+      focus_changed = TRUE;
+    }
+
+  surface_role_class->apply_state (surface_role, pending);
+
+  if (!has_buffer && was_mapped)
+    {
+      /* Unmapped: back to the state before the initial commit. */
+      layer_surface_unmap (layer_surface);
+      layer_surface_reset (layer_surface);
+      layer_shell_arrange (layer_shell);
+      return;
+    }
+
+  if (layer_surface->held && was_mapped)
+    {
+      /* A grant was taken away: hidden until it is given back. */
+      layer_surface_unmap (layer_surface);
+      layer_shell_arrange (layer_shell);
+      return;
+    }
+
+  if (!has_buffer && layer_surface->held && layer_surface->initialized)
+    {
+      layer_shell_arrange (layer_shell);
+      return;
+    }
+
+  if (!layer_surface->initialized)
+    {
+      MetaDisplay *display = layer_shell_get_display (layer_shell);
+
+      /* The initial commit: pick an output if the client named none (the
+       * one the pointer is on), and answer with a configure. */
+      layer_surface->initialized = TRUE;
+      if (!layer_surface->had_output && layer_surface->monitor_number < 0)
+        layer_surface->monitor_number = meta_display_get_current_monitor (display);
+
+      layer_shell_arrange (layer_shell);
+      return;
+    }
+
+  window = layer_surface_get_window (layer_surface);
+  if (window && was_mapped)
+    {
+      if (old_state.layer != layer_surface->current.layer ||
+          old_state.keyboard_interactivity !=
+          layer_surface->current.keyboard_interactivity)
+        {
+          layer_surface_update_window (layer_surface, window);
+          layer_surface_report_used (layer_surface);
+          focus_changed = TRUE;
+
+          if (layer_surface->current.keyboard_interactivity ==
+              ZWLR_LAYER_SURFACE_V1_KEYBOARD_INTERACTIVITY_NONE)
+            layer_surface_drop_focus (layer_surface);
+        }
+
+      if (layer_state_exclusive_changed (&old_state, &layer_surface->current))
+        work_areas_changed = TRUE;
+    }
+
+  if (work_areas_changed)
+    layer_shell_invalidate_work_areas (layer_shell);
+
+  /* Positions and sizes, from the work areas as they now are. */
+  layer_shell_arrange (layer_shell);
+
+  if (!was_mapped && layer_surface->mapped)
+    {
+      window = layer_surface_get_window (layer_surface);
+      if (window)
+        meta_window_queue (window, META_QUEUE_CALC_SHOWING);
+
+      if (layer_surface_breaks_startup_guard (layer_surface))
+        {
+          layer_surface_close (layer_surface);
+          return;
+        }
+    }
+
+  layer_shell_update_limits (layer_shell);
+
+  if (focus_changed)
+    {
+      if (!was_mapped)
+        layer_surface_focus_on_map (layer_surface);
+      layer_shell_sync_keyboard_focus (layer_shell);
+    }
+}
+
+static MetaWaylandSurface *
+meta_wayland_layer_surface_get_toplevel (MetaWaylandSurfaceRole *surface_role)
+{
+  return meta_wayland_surface_role_get_surface (surface_role);
+}
