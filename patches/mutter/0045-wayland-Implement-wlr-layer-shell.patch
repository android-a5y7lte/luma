   sync_actor_stacking (compositor);
 }
 
+static ClutterActor *
+get_window_group_for_window (MetaCompositor *compositor,
+                             MetaWindow     *window)
+{
+  MetaCompositorPrivate *priv =
+    meta_compositor_get_instance_private (compositor);
+  MetaWindow *root = meta_window_find_root_ancestor (window);
+
+  if (window->layer == META_LAYER_OVERRIDE_REDIRECT)
+    return priv->top_window_group;
+
+  /* An overlay layer surface, and its popups. */
+  if (root->is_layer_surface && root->layer_shell_layer == 3)
+    return priv->layer_overlay_group;
+
+  return priv->window_group;
+}
+
+static void
+sync_window_group (MetaCompositor *compositor,
+                   MetaWindow     *window)
+{
+  MetaWindowActor *window_actor = meta_window_actor_from_window (window);
+  ClutterActor *actor;
+  ClutterActor *group;
+  ClutterActor *parent;
+
+  if (!window_actor)
+    return;
+
+  actor = CLUTTER_ACTOR (window_actor);
+  group = get_window_group_for_window (compositor, window);
+  parent = clutter_actor_get_parent (actor);
+
+  /* Only actors in one of the groups: not one an effect holds elsewhere. */
+  if (!parent || parent == group)
+    return;
+
+  if (!META_IS_WINDOW_GROUP (parent))
+    return;
+
+  g_object_ref (actor);
+  clutter_actor_remove_child (parent, actor);
+  clutter_actor_add_child (group, actor);
+  g_object_unref (actor);
+}
+
+static gboolean
+sync_transient_window_group (MetaWindow *window,
+                             void       *data)
+{
+  sync_window_group (data, window);
+  return TRUE;
+}
+
+/**
+ * meta_compositor_sync_window_group: (skip)
+ *
+ * Moves @window's actor, and those of its transients, to the group its kind
+ * of window belongs in.
+ */
+void
+meta_compositor_sync_window_group (MetaCompositor *compositor,
+                                   MetaWindow     *window)
+{
+  sync_window_group (compositor, window);
+  meta_window_foreach_transient (window, sync_transient_window_group,
+                                 compositor);
+  sync_actor_stacking (compositor);
+}
+
 static void
 meta_compositor_real_remove_window (MetaCompositor *compositor,
                                     MetaWindow     *window)
@@ -1028,6 +1124,10 @@ meta_compositor_real_before_paint (MetaCompositor     *compositor,
