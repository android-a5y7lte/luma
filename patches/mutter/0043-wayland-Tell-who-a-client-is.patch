+#pragma once
+
+#include <glib.h>
+#include <wayland-server-core.h>
+
+/*
+ * Who a Wayland client is, looked up once per client from what the kernel
+ * says about the connecting process.
+ *
+ * Sandboxed:
+ * - Flatpak: /proc/PID/root/.flatpak-info, [Application] name;
+ * - Snap: an AppArmor label "snap.NAME.APP";
+ * - Luma capsules: the SELinux domain luma_application.process of the peer
+ *   (SO_PEERSEC);
+ * - Luma closure applications: a systemd scope app-luma-*.scope.
+ * A client whose process cannot be inspected counts as sandboxed. Capsules
+ * and closure applications have no application ID yet: their identity is
+ * the SELinux category pair and scope the application model allocates
+ * (ADR-052, Permissions 8), which that work will map to an application.
+ *
+ * The Shell's own: clients Mutter started (MetaWaylandClient) and the
+ * compositor process itself.
+ *
+ * Everything else is a host client. Its application ID is the desktop-file
+ * ID of its systemd scope (app-LAUNCHER-ID-*.scope) or, started from a
+ * terminal, its executable's name. A host client can do what the person can,
+ * so this ID names it for permissions; it is not a security boundary.
+ */
+typedef struct _MetaWaylandClientIdentity
+{
+  gboolean sandboxed;
+  gboolean is_shell;
+  const char *engine;   /* "flatpak", "snap", "luma-capsule", "luma" or NULL */
+  char *app_id;         /* NULL when nothing says */
+  int64_t start_time_us; /* process start, CLOCK_BOOTTIME; 0 if unknown */
+} MetaWaylandClientIdentity;
+
+const MetaWaylandClientIdentity * meta_wayland_client_get_identity (const struct wl_client *client);
+
+/* CLOCK_BOOTTIME, in microseconds, comparable with start_time_us. */
+int64_t meta_wayland_client_identity_now_us (void);
